---
// IndustriesGrid.astro — Sector-Specific Customer Acquisition Playbooks (Light Corporate Edition)
const industries = [
  {
    title: "Automotive Showrooms & Dealers",
    desc: "Drive consistent test-drive bookings, inventory visibility, and high-trust local buyer inquiries through hyper-local Google SEO and 4K vehicle walkarounds.",
    metric: "+140% Inquiries",
    badge: "Automotive",
    badgeBg: "bg-orange-50 text-orange-700 border-orange-200",
    icon: "🚗"
  },
  {
    title: "Education & Coaching Academies",
    desc: "Attract prospective student enrollments, syllabus downloads, and competitive exam aspirants across Karnataka with keyword dominance.",
    metric: "Top 3 Google Rank",
    badge: "Education",
    badgeBg: "bg-blue-50 text-blue-700 border-blue-200",
    icon: "🎓"
  },
  {
    title: "Agriculture & Organic Produce",
    desc: "Connect organic farms and rural agri-ventures directly to urban consumers in Mysuru and Bengaluru without middleman markups.",
    metric: "+120% Direct Orders",
    badge: "Agro & Retail",
    badgeBg: "bg-emerald-50 text-emerald-700 border-emerald-200",
    icon: "🌱"
  },
  {
    title: "Hospitality, Cafes & Fine Dining",
    desc: "Draw food enthusiasts and weekend travelers with mouthwatering 4K video reels, Google Maps review generation, and viral social storytelling.",
    metric: "3.2x Footfall",
    badge: "Dining & Cafes",
    badgeBg: "bg-rose-50 text-rose-700 border-rose-200",
    icon: "☕"
  },
  {
    title: "Real Estate & Architecture",
    desc: "Showcase residential layouts, luxury villas, and commercial spaces through cinematic drone walkthroughs and investor lead funnels.",
    metric: "High-Ticket Leads",
    badge: "Real Estate",
    badgeBg: "bg-cyan-50 text-cyan-700 border-cyan-200",
    icon: "🏢"
  },
  {
    title: "Healthcare, Clinics & Doctors",
    desc: "Build community trust, medical authority, and seamless patient appointment bookings with patient education videos and localized search ranking.",
    metric: "Verified Patients",
    badge: "Healthcare",
    badgeBg: "bg-teal-50 text-teal-700 border-teal-200",
    icon: "🏥"
  },
  {
    title: "Personal Brands & Creators",
    desc: "Command keynote authority, consulting requests, and digital prestige through bespoke personal websites, podcast video, and media strategy.",
    metric: "Authority Moat",
    badge: "Personal Brand",
    badgeBg: "bg-purple-50 text-purple-700 border-purple-200",
    icon: "⭐"
  },
  {
    title: "Ambitious Startups & Ventures",
    desc: "Go from initial concept to market-ready digital brand with cohesive visual identity, modern web infrastructure, and early customer acquisition.",
    metric: "Fast Launchpad",
    badge: "Startups",
    badgeBg: "bg-amber-50 text-amber-700 border-amber-200",
    icon: "🚀"
  }
];
---

<section class="py-20 lg:py-28 bg-[#f8fafc] border-b border-slate-200/80" id="industries">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-blue-700 bg-blue-50 border border-blue-200 px-4 py-1.5 rounded-full mb-3">
        Domain Expertise
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 font-display leading-tight">
        Industries We Propel to <span class="text-blue-600">Market Leadership</span>
      </h2>
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-sans">
        Every sector has distinct customer buying habits. We engineer strategies that respect your sector's nuances while maximizing customer acquisition and revenue.
      </p>
    </div>

    <!-- Industries Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {industries.map(item => (
        <div class="card-light p-6 flex flex-col justify-between group">
          <div>
            <!-- Top Strip -->
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-xl bg-slate-100 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">
                {item.icon}
              </div>
              <span class={`text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full border ${item.badgeBg}`}>
                {item.badge}
              </span>
            </div>

            <!-- Title -->
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-2 font-display leading-snug">
              {item.title}
            </h3>

            <!-- Description -->
            <p class="text-xs text-slate-600 leading-relaxed font-sans mb-5">
              {item.desc}
            </p>
          </div>

          <!-- Bottom Footer -->
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-slate-900">
              {item.metric}
            </span>
            <button 
              type="button" 
              class="text-xs font-bold text-slate-500 group-hover:text-blue-600 flex items-center gap-1 trigger-audit-modal cursor-pointer transition-colors font-display"
            >
              <span>Explore Playbook</span>
              <span>→</span>
            </button>
          </div>

        </div>
      ))}
    </div>

    <!-- Section Bottom CTA -->
    <div class="mt-14 text-center">
      <div class="inline-flex flex-wrap items-center justify-center gap-4 p-5 rounded-2xl bg-white border border-slate-200 shadow-sm max-w-xl mx-auto">
        <span class="text-xs text-slate-700 font-medium">
          Operating in a specialized niche? We build custom funnels for any business.
        </span>
        <button type="button" class="btn-cta-orange text-xs py-2 px-4 trigger-audit-modal cursor-pointer font-bold">
          Request Industry Consultation
        </button>
      </div>
    </div>

  </div>
</section>
