---
// AuditModal.astro — Free Website & SEO Audit Modal (Clean Light Edition)
---

<div 
  id="global-audit-modal" 
  class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-6 bg-slate-900/75 backdrop-blur-md transition-all duration-300 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="audit-modal-title"
>
  <!-- Modal Dialog Container (Scrollable on small/landscape screens) -->
  <div class="relative w-full max-w-2xl max-h-[92vh] overflow-y-auto overscroll-contain bg-white text-slate-900 rounded-3xl shadow-2xl border border-slate-200 transition-all my-auto">
    
    <!-- Close Button -->
    <button 
      type="button" 
      id="close-audit-modal"
      class="absolute top-4 right-4 z-20 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 flex items-center justify-center transition-all focus:outline-none border border-slate-200 cursor-pointer"
      aria-label="Close modal"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="grid grid-cols-1 md:grid-cols-12">
      
      <!-- Modal Left Accent Panel (Desktop - Deep Navy Theme) -->
      <div class="hidden md:flex md:col-span-5 bg-[#0f172a] text-white p-8 flex-col justify-between relative overflow-hidden">
        <div class="relative z-10">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-[#ea580c] to-[#f97316] text-white font-extrabold flex items-center justify-center text-lg mb-6 shadow-md font-display">
            TC
          </div>
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-orange-400 block mb-1">
            Complimentary 360° Review
          </span>
          <h3 class="text-xl font-bold tracking-tight mb-3 font-display text-white">
            Digital Marketing & Growth Audit
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-6 font-sans">
            Get an actionable, founder-led assessment of your paid ad efficiency, social media reach, website conversion funnels, and organic search gaps.
          </p>

          <ul class="space-y-3 text-xs text-slate-300 font-medium">
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-[10px]">✓</span>
              <span>Meta & Google Ads ROAS Audit</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-[10px]">✓</span>
              <span>Social Media & 4K Reel Engagement</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-[10px]">✓</span>
              <span>Landing Page & Lead Funnel Leak Check</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-[10px]">✓</span>
              <span>Google Maps & SEO Intent Opportunity</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-[10px]">✓</span>
              <span>Actionable 90-Day Digital Roadmap</span>
            </li>
          </ul>
        </div>

        <div class="relative z-10 pt-6 border-t border-slate-800 text-[11px] text-slate-400 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Founder Reviewed • Zero Sales Pressure</span>
        </div>
      </div>

      <!-- Modal Right Form Panel -->
      <div class="md:col-span-7 p-6 sm:p-8 bg-white">
        <div class="mb-5">
          <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-orange-600 bg-orange-50 border border-orange-200 px-2.5 py-0.5 rounded-full inline-block mb-1.5">
            24-Hour Founder Review
          </span>
          <h2 id="audit-modal-title" class="text-2xl font-bold text-slate-900 tracking-tight font-display">
            Request Digital Marketing Audit
          </h2>
          <p class="text-xs text-slate-500 mt-1 font-sans">
            Tell us about your brand. We will analyze your campaigns, social presence, and website funnels today.
          </p>
        </div>

        <form id="modal-audit-form" class="space-y-3.5">
          <div>
            <label for="modal-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-display">
              Your Name *
            </label>
            <input 
              type="text" 
              id="modal-name" 
              name="name" 
              required 
              placeholder="e.g. Anand Kumar"
              class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 placeholder-slate-400 font-sans"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="modal-phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-display">
                Phone / WhatsApp *
              </label>
              <input 
                type="tel" 
                id="modal-phone" 
                name="phone" 
                required 
                placeholder="+91 97414 22544"
                class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 placeholder-slate-400 font-sans"
              />
            </div>

            <div>
              <label for="modal-goal" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-display">
                Primary Marketing Goal
              </label>
              <select 
                id="modal-goal" 
                name="goal"
                class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all text-slate-800 font-sans cursor-pointer"
              >
                <option value="lead-ads">Meta & Google Ads (More Inbound Leads)</option>
                <option value="360-growth">360° Full-Stack Digital Marketing</option>
                <option value="social-video">4K Viral Reels & Social Media</option>
                <option value="fast-web">High-Conversion Web Platform</option>
                <option value="seo-maps">Local Search & Google Maps</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="modal-budget" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-display">
                Monthly Ad / Marketing Budget
              </label>
              <select 
                id="modal-budget" 
                name="budget"
                class="w-full px-3 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all text-slate-800 font-sans cursor-pointer"
              >
                <option value="under-25k">Starting Out (&lt; ₹25,000/mo)</option>
                <option value="25k-50k">Growth Phase (₹25,000 – ₹50,000/mo)</option>
                <option value="50k-1lakh">Scale Up (₹50,000 – ₹1 Lakh/mo)</option>
                <option value="above-1lakh">Established Brand (&gt; ₹1 Lakh/mo)</option>
              </select>
            </div>

            <div>
              <label for="modal-website" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1 font-display">
                Website or Instagram
              </label>
              <input 
                type="text" 
                id="modal-website" 
                name="website" 
                placeholder="https://brand.com or @handle"
                class="w-full px-3.5 py-2.5 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 placeholder-slate-400 font-sans"
              />
            </div>
          </div>

          <button 
            type="submit" 
            class="w-full btn-cta-orange py-3.5 px-4 text-xs font-bold tracking-wide mt-2 justify-center shadow-md cursor-pointer"
          >
            <span>Request Digital Marketing Audit</span>
            <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>

          <!-- Direct Founder Instant Chips -->
          <div class="pt-3 border-t border-slate-100">
            <span class="block text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 text-center mb-2">
              Or Message Founders Directly On WhatsApp:
            </span>
            <div class="grid grid-cols-3 gap-1.5">
              <a 
                href="https://wa.me/919742963370?text=Hi%20Naveen%2C%20I%20would%20like%20to%20discuss%20Video%20Production." 
                target="_blank" 
                rel="noopener noreferrer"
                class="p-1.5 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200 text-[10px] font-bold text-center block transition-colors truncate"
              >
                NV: Naveen
              </a>
              <a 
                href="https://wa.me/919741422544?text=Hi%20Hemanth%2C%20I%20would%20like%20to%20discuss%20Paid%20Ads." 
                target="_blank" 
                rel="noopener noreferrer"
                class="p-1.5 rounded-lg bg-orange-50 hover:bg-orange-100 text-orange-700 border border-orange-200 text-[10px] font-bold text-center block transition-colors truncate"
              >
                HM: Hemanth
              </a>
              <a 
                href="https://wa.me/918197974368?text=Hi%20Nidhith%2C%20I%20would%20like%20to%20discuss%20Web%20Dev." 
                target="_blank" 
                rel="noopener noreferrer"
                class="p-1.5 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-[10px] font-bold text-center block transition-colors truncate"
              >
                ND: Nidhith
              </a>
            </div>
          </div>
        </form>

        <!-- Success Notification -->
        <div id="modal-audit-success" class="hidden mt-4 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs text-center">
          <span class="font-bold block text-sm mb-1">Marketing Audit Scheduled!</span>
          <p class="mb-3">Opening WhatsApp with your dedicated founder lead for instant priority consultation...</p>
          <a 
            id="modal-wa-direct-btn"
            href="https://wa.me/919741422544" 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn-whatsapp-pill py-2.5 px-4 text-xs font-bold text-white inline-flex shadow-sm"
          >
            <span>Continue on WhatsApp →</span>
          </a>
        </div>

      </div>

    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('global-audit-modal');
  const closeBtn = document.getElementById('close-audit-modal');
  const modalForm = document.getElementById('modal-audit-form') as HTMLFormElement | null;
  const modalSuccess = document.getElementById('modal-audit-success');
  const modalWaDirect = document.getElementById('modal-wa-direct-btn') as HTMLAnchorElement | null;

  function openAuditModal() {
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.classList.add('modal-open');
    }
  }

  function closeAuditModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.classList.remove('modal-open');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.trigger-audit-modal').forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openAuditModal();
      });
    });
  });

  if (closeBtn) {
    closeBtn.addEventListener('click', closeAuditModal);
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeAuditModal();
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeAuditModal();
    }
  });

  if (modalForm && modalSuccess) {
    modalForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(modalForm);
      const name = (formData.get('name') as string) || '';
      const phone = (formData.get('phone') as string) || '';
      const goal = (formData.get('goal') as string) || 'lead-ads';
      const budget = (formData.get('budget') as string) || '';
      const website = (formData.get('website') as string) || '';

      // Route by goal:
      // social-video -> Naveen (9742963370)
      // fast-web, seo-maps -> Nidhith (8197974368)
      // lead-ads, 360-growth -> Hemanth (9741422544)
      let targetPhone = "9741422544";
      let founderName = "Hemanth";
      if (goal === 'social-video') {
        targetPhone = "9742963370";
        founderName = "Naveen";
      } else if (goal === 'fast-web' || goal === 'seo-maps') {
        targetPhone = "8197974368";
        founderName = "Nidhith";
      }

      const text = `Hi ${founderName}%20%26%20TC%20Web%20Studio%2C%20I%20requested%20a%20Digital%20Marketing%20Audit!%0A%0A*Name:*%20${encodeURIComponent(name)}%0A*Phone:*%20${encodeURIComponent(phone)}%0A*Goal:*%20${encodeURIComponent(goal)}%0A*Budget:*%20${encodeURIComponent(budget)}%0A*Website:*%20${encodeURIComponent(website || 'None provided')}`;
      const waUrl = `https://wa.me/91${targetPhone}?text=${text}`;

      if (modalWaDirect) {
        modalWaDirect.href = waUrl;
      }

      modalForm.classList.add('opacity-50', 'pointer-events-none');
      
      // Auto-open WhatsApp redirect
      window.open(waUrl, '_blank');

      setTimeout(() => {
        modalForm.classList.add('hidden');
        modalSuccess.classList.remove('hidden');
      }, 500);
    });
  }
</script>
