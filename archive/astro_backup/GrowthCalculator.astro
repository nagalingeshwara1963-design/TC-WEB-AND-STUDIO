---
// GrowthCalculator.astro — Clean Interactive Pipeline & Growth Forecast Widget
---

<section class="py-20 lg:py-28 bg-white border-b border-slate-200/80 relative overflow-hidden" id="calculator">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-orange-600 bg-orange-50 border border-orange-200 px-4 py-1.5 rounded-full mb-3">
        Interactive ROI Calculator
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight font-display text-slate-900 mb-4">
        Calculate Your Business <span class="text-gradient-orange">Growth Potential</span>
      </h2>
      <p class="text-slate-600 text-base leading-relaxed max-w-xl mx-auto font-sans">
        Select your industry and current monthly lead volume to forecast the multi-channel digital marketing pipeline and revenue return you can achieve.
      </p>
    </div>

    <!-- The Interactive Calculator Card -->
    <div class="max-w-5xl mx-auto bg-slate-50 border border-slate-200/90 rounded-3xl p-6 sm:p-10 lg:p-12 shadow-sm">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Controls Column (Left) -->
        <div class="lg:col-span-7 space-y-8">
          
          <!-- Step 1: Industry Selection -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider font-display flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-orange-100 text-orange-700 flex items-center justify-center text-[10px] font-mono font-bold">1</span>
                Select Your Industry
              </label>
              <span class="text-xs text-slate-500 font-mono font-bold" id="selected-ind-label">Automotive</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs font-medium">
              <button type="button" class="calc-ind-btn py-3 px-3 rounded-xl border border-orange-500 bg-orange-50 text-orange-700 font-bold transition-all flex flex-col items-center gap-1 cursor-pointer shadow-sm" data-ind="automotive" data-avg="45000">
                <span class="text-lg">🚗</span>
                <span>Automotive</span>
              </button>
              <button type="button" class="calc-ind-btn py-3 px-3 rounded-xl border border-slate-200 bg-white text-slate-700 font-semibold hover:border-slate-300 transition-all flex flex-col items-center gap-1 cursor-pointer" data-ind="education" data-avg="32000">
                <span class="text-lg">🎓</span>
                <span>Education</span>
              </button>
              <button type="button" class="calc-ind-btn py-3 px-3 rounded-xl border border-slate-200 bg-white text-slate-700 font-semibold hover:border-slate-300 transition-all flex flex-col items-center gap-1 cursor-pointer" data-ind="agriculture" data-avg="28000">
                <span class="text-lg">🌱</span>
                <span>Agro / Retail</span>
              </button>
              <button type="button" class="calc-ind-btn py-3 px-3 rounded-xl border border-slate-200 bg-white text-slate-700 font-semibold hover:border-slate-300 transition-all flex flex-col items-center gap-1 cursor-pointer" data-ind="services" data-avg="38000">
                <span class="text-lg">💼</span>
                <span>Services</span>
              </button>
            </div>
          </div>

          <!-- Step 2: Current Inquiries Slider -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <label class="text-xs font-bold text-slate-700 uppercase tracking-wider font-display flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-orange-100 text-orange-700 flex items-center justify-center text-[10px] font-mono font-bold">2</span>
                Current Monthly Inbound Leads:
              </label>
              <span id="slider-leads-val" class="font-mono text-sm font-bold text-orange-700 bg-orange-100/70 px-3 py-1 rounded-lg border border-orange-200">
                15 leads/mo
              </span>
            </div>
            <div class="relative pt-2 pb-1">
              <input 
                type="range" 
                id="leads-slider" 
                min="5" 
                max="100" 
                value="15" 
                step="5"
                class="w-full h-2.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-orange-600 focus:outline-none"
              />
            </div>
            <div class="flex justify-between text-[11px] text-slate-500 font-mono mt-2">
              <span>5 / month (Starting)</span>
              <span>50 / month</span>
              <span>100+ / month (Scaling)</span>
            </div>
          </div>

          <!-- Step 3: Desired Trajectory -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-3 font-display flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-orange-100 text-orange-700 flex items-center justify-center text-[10px] font-mono font-bold">3</span>
              Select Growth Speed
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <button type="button" class="calc-tier-btn p-4 rounded-2xl border border-emerald-500 bg-emerald-50 text-emerald-900 font-bold transition-all text-left cursor-pointer shadow-sm group" data-multiplier="2.4" data-label="Sprint Velocity">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm font-display text-slate-900">Sprint Velocity (2.4x)</span>
                  <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                </div>
                <span class="text-xs text-slate-600 font-normal">High-Conversion Web Funnel + Targeted Meta & Local Ads</span>
              </button>

              <button type="button" class="calc-tier-btn p-4 rounded-2xl border border-slate-200 bg-white text-slate-700 font-bold hover:border-slate-300 transition-all text-left cursor-pointer group" data-multiplier="3.8" data-label="Market Dominance">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-sm font-display text-slate-900">Market Dominance (3.8x)</span>
                  <span class="w-2.5 h-2.5 rounded-full bg-slate-300 group-hover:bg-orange-500"></span>
                </div>
                <span class="text-xs text-slate-600 font-normal">360° Full Marketing: Meta Ads + 4K Reels + Google Ads + SEO</span>
              </button>
            </div>
          </div>

        </div>

        <!-- Dynamic Results Forecast Card (Right - Enterprise Slate Navy Theme) -->
        <div class="lg:col-span-5">
          <div class="bg-[#0f172a] text-white rounded-3xl p-7 sm:p-8 text-center relative overflow-hidden shadow-xl border border-slate-800">
            <!-- Subtle Glow -->
            <div class="absolute -top-12 -right-12 w-40 h-40 bg-blue-600/20 rounded-full blur-2xl pointer-events-none"></div>

            <div class="inline-flex items-center gap-1.5 text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/15 border border-emerald-500/30 px-3 py-1 rounded-full mb-6">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Estimated 90-Day Forecast
            </div>

            <!-- Main Metric -->
            <div class="mb-6">
              <span class="text-xs uppercase tracking-wider text-slate-300 font-display block mb-1">
                Projected Monthly Inquiries
              </span>
              <div class="flex items-baseline justify-center gap-2">
                <span id="res-leads" class="text-5xl sm:text-6xl font-black font-display text-white tracking-tight">
                  36
                </span>
                <span class="text-emerald-400 font-bold text-base font-mono">
                  leads/mo
                </span>
              </div>
              <div class="mt-2 inline-flex items-center gap-1.5 text-xs text-emerald-400 font-bold bg-emerald-500/10 px-3 py-1 rounded-full">
                <span id="res-lead-lift">+21 net new inquiries</span>
              </div>
            </div>

            <!-- Secondary Metrics Grid -->
            <div class="grid grid-cols-2 gap-3 mb-6 pt-5 border-t border-slate-800 text-left">
              <div class="bg-slate-800/60 p-3.5 rounded-xl border border-slate-700/60">
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block mb-1 font-mono">Est. Deal Value</span>
                <span id="res-revenue" class="text-lg font-bold text-white font-display">₹9.4 Lakhs</span>
                <span class="text-[10px] text-slate-400 block">in monthly pipeline</span>
              </div>

              <div class="bg-slate-800/60 p-3.5 rounded-xl border border-slate-700/60">
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block mb-1 font-mono">Channel Reach</span>
                <span class="text-lg font-bold text-orange-400 font-display">Ads + Social + SEO</span>
                <span class="text-[10px] text-slate-400 block">multi-touch acquisition</span>
              </div>
            </div>

            <!-- CTA Buttons -->
            <button 
              type="button" 
              class="w-full btn-cta-orange py-3.5 px-5 text-xs sm:text-sm font-bold tracking-wide trigger-audit-modal cursor-pointer shadow-md"
            >
              <span>Unlock Digital Marketing Roadmap</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>

            <a 
              id="calc-wa-btn"
              href="https://wa.me/919741422544?text=Hi%20Hemanth%20%26%20Naveen%2C%20I%20calculated%20our%20growth%20projection%20on%20your%20website%20and%20want%20to%20discuss%20a%20marketing%20sprint."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full mt-2.5 py-3 px-4 text-xs font-bold rounded-xl bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/30 flex items-center justify-center gap-2 transition-all cursor-pointer"
            >
              <svg class="w-3.5 h-3.5 fill-current text-emerald-400" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              <span>Discuss Forecast on WhatsApp</span>
            </a>

            <p class="text-[10px] text-slate-400 mt-3 font-mono">
              *Projections derived from historic partner growth trajectories in Karnataka.
            </p>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  const leadsSlider = document.getElementById('leads-slider') as HTMLInputElement | null;
  const leadsValDisplay = document.getElementById('slider-leads-val');
  const resLeadsDisplay = document.getElementById('res-leads');
  const resLeadLiftDisplay = document.getElementById('res-lead-lift');
  const resRevDisplay = document.getElementById('res-revenue');
  const indLabelDisplay = document.getElementById('selected-ind-label');
  const calcWaBtn = document.getElementById('calc-wa-btn') as HTMLAnchorElement | null;

  let currentMultiplier = 2.4;
  let currentAvgDeal = 45000;

  function updateCalculator() {
    if (!leadsSlider) return;
    const currentLeads = parseInt(leadsSlider.value, 10);
    
    if (leadsValDisplay) {
      leadsValDisplay.textContent = `${currentLeads} leads/mo`;
    }

    const projectedLeads = Math.round(currentLeads * currentMultiplier);
    const netLift = projectedLeads - currentLeads;
    const estimatedPipeline = (projectedLeads * currentAvgDeal) / 100000;

    if (resLeadsDisplay) {
      resLeadsDisplay.textContent = `${projectedLeads}`;
    }

    if (resLeadLiftDisplay) {
      resLeadLiftDisplay.textContent = `+${netLift} net new inquiries`;
    }

    if (resRevDisplay) {
      resRevDisplay.textContent = `₹${estimatedPipeline.toFixed(1)} Lakhs`;
    }

    if (calcWaBtn) {
      const msg = `Hi Hemanth & Naveen, I just ran the growth calculator on your website: Current ${currentLeads} leads/mo -> Forecast ${projectedLeads} leads/mo (₹${estimatedPipeline.toFixed(1)}L pipeline). Can we discuss a marketing strategy sprint?`;
      calcWaBtn.href = `https://wa.me/919741422544?text=${encodeURIComponent(msg)}`;
    }
  }

  if (leadsSlider) {
    leadsSlider.addEventListener('input', updateCalculator);
  }

  const indButtons = document.querySelectorAll('.calc-ind-btn');
  indButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      indButtons.forEach(b => {
        b.classList.remove('border-orange-500', 'bg-orange-50', 'text-orange-700', 'shadow-sm');
        b.classList.add('border-slate-200', 'bg-white', 'text-slate-700');
      });
      btn.classList.remove('border-slate-200', 'bg-white', 'text-slate-700');
      btn.classList.add('border-orange-500', 'bg-orange-50', 'text-orange-700', 'shadow-sm');

      const ind = btn.getAttribute('data-ind');
      const avg = btn.getAttribute('data-avg');
      if (avg) currentAvgDeal = parseInt(avg, 10);
      if (indLabelDisplay && ind) {
        indLabelDisplay.textContent = ind.charAt(0).toUpperCase() + ind.slice(1);
      }
      updateCalculator();
    });
  });

  const tierButtons = document.querySelectorAll('.calc-tier-btn');
  tierButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tierButtons.forEach(b => {
        b.classList.remove('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'shadow-sm');
        b.classList.add('border-slate-200', 'bg-white', 'text-slate-700');
        const indicator = b.querySelector('.rounded-full');
        if (indicator) indicator.className = 'w-2.5 h-2.5 rounded-full bg-slate-300';
      });
      btn.classList.remove('border-slate-200', 'bg-white', 'text-slate-700');
      btn.classList.add('border-emerald-500', 'bg-emerald-50', 'text-emerald-900', 'shadow-sm');
      const activeIndicator = btn.querySelector('.rounded-full');
      if (activeIndicator) activeIndicator.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500';

      const mult = btn.getAttribute('data-multiplier');
      if (mult) currentMultiplier = parseFloat(mult);
      updateCalculator();
    });
  });

  updateCalculator();
</script>
