---
import Section from './Section.astro';
---

<Section id="contact" class="bg-brand-accent text-white" yPadding="xl">
  <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
    <h2 class="text-4xl md:text-5xl lg:text-7xl font-medium tracking-tight mb-8">
      Have something <br class="hidden sm:block"/>
      <span class="font-serif italic">worth building?</span>
    </h2>
    
    <p class="text-white/80 text-lg md:text-xl max-w-2xl mb-12">
      Let's discuss your goals, requirements, and project scope. We're currently taking on new projects across strategy, design, and digital experiences.
    </p>
    
    <a 
      href="mailto:hello@tcwebstudio.com" 
      class="inline-flex items-center justify-center px-8 py-4 md:px-10 md:py-5 text-lg font-medium text-brand-accent bg-white hover:bg-brand-bg hover:scale-105 transition-all rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-white focus-visible:ring-offset-brand-accent shadow-lg"
    >
      Start a Project
    </a>
    
    <p class="mt-8 text-white/50 text-xs tracking-wider uppercase">
      (Contact mechanism pending final details)
    </p>
  </div>
</Section>
