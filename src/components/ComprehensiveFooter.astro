---
// ComprehensiveFooter.astro — Rich enterprise anchor footer
const currentYear = new Date().getFullYear();

const services = [
  { name: "360° Digital Marketing & Paid Ads", href: "#marketing" },
  { name: "Meta & Instagram Lead Ads", href: "#marketing" },
  { name: "Custom Web Development", href: "#web-development" },
  { name: "4K Video Reels & Commercials", href: "#social-media" },
  { name: "Search Engine Optimization (SEO)", href: "#seo" },
  { name: "Google Maps 3-Pack Growth", href: "#seo" }
];

const quickLinks = [
  { name: "Our 3-Phase Process", href: "#how-we-work" },
  { name: "Client Results & Proof", href: "#case-studies" },
  { name: "Interactive ROI Calculator", href: "#calculator" },
  { name: "Industries We Serve", href: "#industries" },
  { name: "Meet the Founders", href: "#studio" },
  { name: "Mysuru Studio & Contact", href: "#contact" }
];
---

<footer class="bg-[#0f172a] text-slate-300 border-t border-slate-800 relative overflow-hidden">
  <!-- Subtle accent line at top -->
  <div class="h-[3px] bg-gradient-to-r from-blue-600 via-orange-500 to-emerald-500"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20 font-sans">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      
      <!-- Brand Column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-3.5 mb-5 group">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#ea580c] to-[#f97316] flex items-center justify-center text-white font-extrabold text-lg shadow-md font-display">
            TC
          </div>
          <div>
            <span class="block text-xl font-extrabold text-white font-display">TC Web & Studio</span>
            <span class="block text-[10px] text-slate-400 uppercase tracking-widest font-mono font-bold">Digital Growth • Mysuru</span>
          </div>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed mb-6 max-w-xs font-sans">
          Top-ranked digital marketing, custom high-speed web development, and 4K commercial media production from Mysuru, Karnataka.
        </p>
        
        <!-- Social Links -->
        <div class="flex items-center gap-3">
          <a href="#" class="w-9 h-9 rounded-xl bg-slate-800/80 border border-slate-700 flex items-center justify-center text-slate-400 hover:text-white hover:border-orange-500 transition-all" aria-label="Instagram">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="#" class="w-9 h-9 rounded-xl bg-slate-800/80 border border-slate-700 flex items-center justify-center text-slate-400 hover:text-white hover:border-orange-500 transition-all" aria-label="LinkedIn">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://wa.me/919741422544" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 hover:bg-emerald-500/30 transition-all" aria-label="WhatsApp">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
          </a>
        </div>
      </div>

      <!-- Services Column -->
      <div>
        <h4 class="text-xs font-bold text-white font-display mb-5 uppercase tracking-wider">Services</h4>
        <ul class="space-y-3">
          {services.map(link => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 hover:text-white transition-colors">{link.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Links Column -->
      <div>
        <h4 class="text-xs font-bold text-white font-display mb-5 uppercase tracking-wider">Studio</h4>
        <ul class="space-y-3">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 hover:text-white transition-colors">{link.name}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- CTA Column -->
      <div>
        <h4 class="text-xs font-bold text-white font-display mb-5 uppercase tracking-wider">Ready to Scale?</h4>
        <p class="text-sm text-slate-400 mb-5 leading-relaxed">
          Get a complimentary 360° digital marketing audit and growth roadmap within 24 hours.
        </p>
        <button type="button" class="btn-cta-orange w-full text-xs py-3.5 trigger-audit-modal mb-3 font-bold">
          Free Marketing Audit
        </button>
        <a href="tel:+919741422544" class="w-full inline-flex items-center justify-center py-2.5 px-4 text-xs font-bold rounded-xl border border-slate-700 text-slate-300 hover:text-white hover:bg-slate-800 transition-colors mb-2">
          Call Founders: +91 97414 22544
        </a>
        <div class="flex items-center justify-between text-[11px] text-slate-400 pt-2 border-t border-slate-800 font-mono">
          <a href="https://wa.me/919742963370" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">WA Naveen</a>
          <span>•</span>
          <a href="https://wa.me/919741422544" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">WA Hemanth</a>
          <span>•</span>
          <a href="https://wa.me/918197974368" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 transition-colors">WA Nidhith</a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <span>© {currentYear} TC Web & Studio. All rights reserved. Registered in Mysuru, Karnataka, India.</span>
      <div class="flex items-center gap-4">
        <a href="#hero" class="hover:text-slate-300 transition-colors">Back to Top ↑</a>
        <span class="w-1 h-1 rounded-full bg-slate-700"></span>
        <a href="#contact" class="hover:text-slate-300 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
