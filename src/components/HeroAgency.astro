<!-- ──────────────────────────────────────────
     SCRIPTS: QUOTE FORM DISPATCH & VIDEO SOUND
     ────────────────────────────────────────── -->
<script>
  // 1. WhatsApp Quote Form Dispatch
  const quoteForm = document.getElementById('hero-quote-form') as HTMLFormElement | null;
  const successBanner = document.getElementById('quote-success-banner');
  const notifyNaveen = document.getElementById('notify-naveen-btn') as HTMLAnchorElement | null;
  const notifyHemanth = document.getElementById('notify-hemanth-btn') as HTMLAnchorElement | null;

  if (quoteForm) {
    quoteForm.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const whatsappInput = (document.getElementById('quote-whatsapp') as HTMLInputElement)?.value.trim();
      const nameInput = (document.getElementById('quote-name') as HTMLInputElement)?.value.trim();
      const bizType = (document.getElementById('quote-business-type') as HTMLSelectElement)?.value;
      const notes = (document.getElementById('quote-notes') as HTMLTextAreaElement)?.value.trim() || 'Not specified';

      if (!whatsappInput || !nameInput || !bizType) {
        alert('Please fill out your Name, WhatsApp Number, and Business Type.');
        return;
      }

      // Format message text
      const message = `Hi Nidhith! New Inquiry from TC Web & Studio website:
Name: ${nameInput}
WhatsApp: +91 ${whatsappInput}
Business Type: ${bizType}
Project Details: ${notes}`;

      const encodedMessage = encodeURIComponent(message);

      // Primary WhatsApp link directly to Nidhith (8197974368)
      const nidhithUrl = `https://wa.me/918197974368?text=${encodedMessage}`;
      
      // Secondary links for Naveen (9742963370) and Hemanth (9741422544)
      const naveenUrl = `https://wa.me/919742963370?text=${encodedMessage}`;
      const hemanthUrl = `https://wa.me/919741422544?text=${encodedMessage}`;

      if (notifyNaveen) notifyNaveen.href = naveenUrl;
      if (notifyHemanth) notifyHemanth.href = hemanthUrl;
      if (successBanner) successBanner.classList.remove('hidden');

      // Open primary WhatsApp tab to Nidhith
      window.open(nidhithUrl, '_blank');
    });
  }

  // 2. Video Sound Toggle Controller
  const video = document.getElementById('intro-studio-video') as HTMLVideoElement | null;
  const soundBtn = document.getElementById('toggle-video-sound');
  const mutedIcon = document.getElementById('sound-muted-icon');
  const activeIcon = document.getElementById('sound-active-icon');
  const soundText = document.getElementById('sound-toggle-text');

  if (video && soundBtn && mutedIcon && activeIcon && soundText) {
    soundBtn.addEventListener('click', () => {
      if (video.muted) {
        video.muted = false;
        video.play().catch(() => {});
        mutedIcon.classList.add('hidden');
        activeIcon.classList.remove('hidden');
        soundText.textContent = 'Mute Audio';
        soundBtn.classList.add('border-emerald-400');
      } else {
        video.muted = true;
        mutedIcon.classList.remove('hidden');
        activeIcon.classList.add('hidden');
        soundText.textContent = 'Tap for Sound';
        soundBtn.classList.remove('border-emerald-400');
      }
    });
  }

  // 3. Fullscreen Controller (Desktop & iOS Safari Mobile Compatible)
  const fullscreenBtn = document.getElementById('fullscreen-video-btn');
  if (video && fullscreenBtn) {
    fullscreenBtn.addEventListener('click', () => {
      if ((video as any).webkitEnterFullscreen) {
        // Native iOS Safari on iPhones
        (video as any).webkitEnterFullscreen();
      } else if (video.requestFullscreen) {
        video.requestFullscreen();
      } else if ((video as any).webkitRequestFullscreen) {
        (video as any).webkitRequestFullscreen();
      } else if ((video as any).msRequestFullscreen) {
        (video as any).msRequestFullscreen();
      }
    });
  }
</script>
