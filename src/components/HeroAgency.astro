---
// HeroAgency.astro — Opening First Face (Light theme with purple tint & gold accents)
// Left: Website intro + creative services list
// Right: Get Quote card (WhatsApp, Name, Business Type) + Muted Intro Video with Sound Toggle
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative pt-12 pb-20 lg:pt-16 lg:pb-28 bg-[#faf8ff] bg-purple-mesh border-b border-purple-200/60 overflow-hidden" id="hero">
  <!-- Aesthetic Floating Decorative Ambient Orbs -->
  <div class="absolute -top-12 left-1/4 w-[34rem] h-[34rem] bg-purple-300/35 rounded-full blur-3xl pointer-events-none animate-float-slow"></div>
  <div class="absolute top-28 -right-12 w-[28rem] h-[28rem] bg-amber-200/40 rounded-full blur-3xl pointer-events-none animate-float-reverse"></div>
  <div class="absolute bottom-10 left-10 w-72 h-72 bg-purple-200/25 rounded-full blur-3xl pointer-events-none animate-float-slow"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      
      <!-- ══════════════════════════════════════════════
           LEFT COLUMN: Website Intro & Creative Services
           ══════════════════════════════════════════════ -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        
        <!-- Studio Pill Tag with Pulsing Live Indicator & Rotating Star -->
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-purple-900 bg-purple-100/90 border border-purple-300/80 px-4 py-1.5 rounded-full w-fit mb-5 shadow-sm shadow-purple-500/10 hover:scale-105 transition-transform duration-300">
          <span class="inline-block text-amber-500 animate-spin-slow">✦</span>
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Digital Marketing & Web Development Studio • Mysuru</span>
        </div>

        <!-- Main Aesthetic Bold Headline with Animated Shifting Gradients -->
        <h1 class="text-3xl sm:text-5xl lg:text-[3.4rem] font-extrabold text-[#180f2d] tracking-tight leading-[1.14] mb-5 font-display">
          Crafting High-Performance <span class="text-gradient-purple font-extrabold">Digital Marketing</span> & <span class="text-gradient-gold font-extrabold">Custom Websites</span>
        </h1>

        <!-- Intro Description with refined leading and typography -->
        <p class="text-[#43395b] text-base sm:text-lg leading-relaxed mb-8 font-sans max-w-2xl font-normal">
          We are <strong class="text-purple-950 font-bold">TC Web & Studio</strong> — an agile, skill-driven creative powerhouse founded by three hands-on specialists in Mysuru. We build high-speed custom web platforms, run ROI-driven Meta and Google ad campaigns, film viral 4K video reels, and design high-impact posters that convert viewers into loyal paying customers.
        </p>

        <!-- Trust Badges Strip with Subtle Hover Lift -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-10 text-xs font-semibold text-[#5a4f73]">
          <span class="flex items-center gap-2 bg-white/95 border border-purple-200/80 px-3.5 py-1.5 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
            <div class="flex -space-x-2 shrink-0">
              <button type="button" data-founder-preview="naveen" class="cursor-pointer hover:scale-115 hover:z-10 transition-transform focus:outline-none" title="Click to view portrait of Naveen">
                <img src={`${basePath}/images/founders/naveen.jpg`} alt="Naveen" class="w-8 h-8 rounded-full border-2 border-white object-cover shadow-xs" style="object-position: 50% 36%;" />
              </button>
              <button type="button" data-founder-preview="nidhith" class="cursor-pointer hover:scale-115 hover:z-10 transition-transform focus:outline-none" title="Click to view portrait of Nidhith">
                <img src={`${basePath}/images/founders/nidhith.jpg`} alt="Nidhith" class="w-8 h-8 rounded-full border-2 border-white object-cover shadow-xs" style="object-position: 42% 18%;" />
              </button>
              <button type="button" data-founder-preview="hemanth" class="cursor-pointer hover:scale-115 hover:z-10 transition-transform focus:outline-none" title="Click to view portrait of Hemanth">
                <img src={`${basePath}/images/founders/hemanth.jpg`} alt="Hemanth" class="w-8 h-8 rounded-full border-2 border-white object-cover shadow-xs" style="object-position: 50% 48%;" />
              </button>
            </div>
            <span>3 Dedicated Founders <span class="text-purple-600 font-mono">(Tap face to view)</span></span>
          </span>
          <span class="flex items-center gap-1.5 bg-white/95 border border-purple-200/80 px-3.5 py-2 rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
            <svg class="w-4 h-4 text-purple-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            Budget-Friendly & Skill-Driven
          </span>
          <a href="#studio-reel" class="flex items-center gap-2 bg-purple-900 hover:bg-purple-950 text-white px-3.5 py-1.5 rounded-xl shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all text-xs font-bold font-display cursor-pointer border border-purple-400/30">
            <span class="w-2 h-2 rounded-full bg-red-400 animate-pulse"></span>
            <span>▶ Watch 29s Studio Commercial</span>
          </a>
        </div>

        <!-- ──────────────────────────────────────────
             CREATIVE SERVICES LISTING (BELOW INTRO)
             ────────────────────────────────────────── -->
        <div class="pt-6 border-t border-purple-200/70">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xs font-bold uppercase tracking-wider text-purple-900 font-display flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-purple-600 to-amber-500 animate-pulse"></span>
              Our Core Creative & Digital Services
            </h2>
            <a href="#services" class="text-xs font-bold text-amber-700 hover:text-amber-800 transition-colors flex items-center gap-1 group">
              <span>Explore All Services</span>
              <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>
          </div>

          <!-- Creative Interactive Grid with Hover Lift -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            
            <!-- Service 1 -->
            <a href="#services" class="group p-4 rounded-2xl bg-white/95 hover:bg-white border border-purple-100 hover:border-purple-300 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-lg font-bold group-hover:scale-110 group-hover:bg-purple-600 group-hover:text-white transition-all duration-300 shrink-0 shadow-inner">
                🚀
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#180f2d] group-hover:text-purple-700 transition-colors font-display">
                  Digital Marketing & Paid Ads
                </h3>
                <p class="text-xs text-[#5e5377] mt-0.5 leading-snug">
                  High-converting Meta (FB & IG) ad funnels, audience targeting & lead acquisition.
                </p>
              </div>
            </a>

            <!-- Service 2 -->
            <a href="#services" class="group p-4 rounded-2xl bg-white/95 hover:bg-white border border-purple-100 hover:border-amber-300 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-lg font-bold group-hover:scale-110 group-hover:bg-amber-500 group-hover:text-white transition-all duration-300 shrink-0 shadow-inner">
                💻
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#180f2d] group-hover:text-amber-700 transition-colors font-display">
                  Custom Web Development
                </h3>
                <p class="text-xs text-[#5e5377] mt-0.5 leading-snug">
                  Lightning-fast responsive sites, custom landing pages, zero-bloat code.
                </p>
              </div>
            </a>

            <!-- Service 3 -->
            <a href="#services" class="group p-4 rounded-2xl bg-white/95 hover:bg-white border border-purple-100 hover:border-purple-300 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-lg font-bold group-hover:scale-110 group-hover:bg-purple-600 group-hover:text-white transition-all duration-300 shrink-0 shadow-inner">
                🎬
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#180f2d] group-hover:text-purple-700 transition-colors font-display">
                  4K Video & Viral Reels
                </h3>
                <p class="text-xs text-[#5e5377] mt-0.5 leading-snug">
                  Cinematic filming, brand commercials & hook-driven short-form reels.
                </p>
              </div>
            </a>

            <!-- Service 4 -->
            <a href="#services" class="group p-4 rounded-2xl bg-white/95 hover:bg-white border border-purple-100 hover:border-amber-300 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-lg font-bold group-hover:scale-110 group-hover:bg-amber-500 group-hover:text-white transition-all duration-300 shrink-0 shadow-inner">
                🎨
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#180f2d] group-hover:text-amber-700 transition-colors font-display">
                  Posters & Graphic Design
                </h3>
                <p class="text-xs text-[#5e5377] mt-0.5 leading-snug">
                  Aesthetic promotional posters, restaurant menus, social media campaign art.
                </p>
              </div>
            </a>

            <!-- Service 5 -->
            <a href="#services" class="group p-4 rounded-2xl bg-white/95 hover:bg-white border border-purple-100 hover:border-purple-300 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-lg font-bold group-hover:scale-110 group-hover:bg-purple-600 group-hover:text-white transition-all duration-300 shrink-0 shadow-inner">
                🔍
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#180f2d] group-hover:text-purple-700 transition-colors font-display">
                  Search Engine Optimization (SEO)
                </h3>
                <p class="text-xs text-[#5e5377] mt-0.5 leading-snug">
                  Google Map pack ranking, local Mysuru visibility & organic search traffic.
                </p>
              </div>
            </a>

            <!-- Service 6 -->
            <a href="#services" class="group p-4 rounded-2xl bg-white/95 hover:bg-white border border-purple-100 hover:border-amber-300 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-lg font-bold group-hover:scale-110 group-hover:bg-amber-500 group-hover:text-white transition-all duration-300 shrink-0 shadow-inner">
                📱
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#180f2d] group-hover:text-amber-700 transition-colors font-display">
                  Social Media & Brand Identity
                </h3>
                <p class="text-xs text-[#5e5377] mt-0.5 leading-snug">
                  Cohesive brand aesthetics, typography, logo systems & organic page growth.
                </p>
              </div>
            </a>

          </div>
        </div>

      </div>

      <!-- ══════════════════════════════════════════════
           RIGHT COLUMN: Get Quote Card + Muted Intro Video
           ══════════════════════════════════════════════ -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <!-- ── GET QUOTE CARD ── -->
        <div id="quote-card" class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-purple-200/90 shadow-xl shadow-purple-600/10 relative overflow-hidden card-aesthetic-lift">
          <!-- Animated gold/purple header accent line -->
          <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-purple-600 via-amber-400 to-purple-600 animate-shimmer"></div>

          <div class="mb-5">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-amber-700 bg-amber-50 px-2.5 py-0.5 rounded-md border border-amber-200">
                Direct WhatsApp Quote
              </span>
              <span class="text-xs text-purple-700 font-bold flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                Fast Response
              </span>
            </div>
            <h3 class="text-2xl font-extrabold text-[#180f2d] font-display">
              Get a Free Quote
            </h3>
            <p class="text-xs text-[#5e5377] mt-1 font-sans">
              Fill details below. All three founders (Naveen, Nidhith & Hemanth) review every inquiry directly!
            </p>
          </div>

          <!-- Quote Form -->
          <form id="hero-quote-form" class="space-y-4">
            
            <!-- WhatsApp Number (Required) -->
            <div>
              <label for="quote-whatsapp" class="block text-xs font-bold text-[#2e2446] mb-1 font-display">
                WhatsApp Number <span class="text-amber-600">*</span>
              </label>
              <div class="relative">
                <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-xs font-mono font-bold text-slate-400">
                  +91
                </span>
                <input 
                  type="tel" 
                  id="quote-whatsapp" 
                  name="whatsapp" 
                  required 
                  pattern="[0-9]{10}"
                  placeholder="98765 43210"
                  class="w-full pl-12 pr-4 py-3 rounded-xl bg-purple-50/50 border border-purple-200 focus:border-purple-600 focus:bg-white text-sm text-[#1c1335] font-medium outline-none transition-all placeholder:text-slate-400"
                />
              </div>
            </div>

            <!-- Full Name (Required) -->
            <div>
              <label for="quote-name" class="block text-xs font-bold text-[#2e2446] mb-1 font-display">
                Your Name <span class="text-amber-600">*</span>
              </label>
              <input 
                type="text" 
                id="quote-name" 
                name="name" 
                required 
                placeholder="e.g. Ramesh Kumar"
                class="w-full px-4 py-3 rounded-xl bg-purple-50/50 border border-purple-200 focus:border-purple-600 focus:bg-white text-sm text-[#1c1335] font-medium outline-none transition-all placeholder:text-slate-400"
              />
            </div>

            <!-- Business Type / Category (Required) -->
            <div>
              <label for="quote-business-type" class="block text-xs font-bold text-[#2e2446] mb-1 font-display">
                Business Type / Work <span class="text-amber-600">*</span>
              </label>
              <select 
                id="quote-business-type" 
                name="businessType" 
                required
                class="w-full px-4 py-3 rounded-xl bg-purple-50/50 border border-purple-200 focus:border-purple-600 focus:bg-white text-sm text-[#1c1335] font-medium outline-none transition-all cursor-pointer"
              >
                <option value="" disabled selected>Select business type...</option>
                <option value="Brand / Commercial Business">Commercial Brand / Business</option>
                <option value="Personal Brand / Creator">Personal Brand / Creator</option>
                <option value="Other Work / Custom Project">Other Creative / Custom Work</option>
              </select>
            </div>

            <!-- Optional brief requirement note -->
            <div>
              <label for="quote-notes" class="block text-xs font-bold text-[#2e2446] mb-1 font-display">
                Project Details <span class="text-slate-400 font-normal">(Optional)</span>
              </label>
              <textarea 
                id="quote-notes" 
                name="notes" 
                rows="2"
                placeholder="Briefly tell us what you need (Web, Ads, Video, Posters)..."
                class="w-full px-4 py-2.5 rounded-xl bg-purple-50/50 border border-purple-200 focus:border-purple-600 focus:bg-white text-sm text-[#1c1335] font-medium outline-none transition-all placeholder:text-slate-400 resize-none"
              ></textarea>
            </div>

            <!-- Submit Button (Sends to Nidhith & notifies founders) -->
            <button 
              type="submit" 
              class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-emerald-600 via-emerald-500 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold text-sm flex items-center justify-center gap-2.5 shadow-lg shadow-emerald-600/25 transition-all transform hover:-translate-y-0.5 cursor-pointer font-display border border-emerald-300/40"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              <span>Submit & Open WhatsApp</span>
            </button>
            <p class="text-[11px] text-center text-slate-500 font-sans">
              🔒 Instant WhatsApp dispatch with your quote request.
            </p>
          </form>

          <!-- Success / Multi-Founder Dispatch Banner (Hidden by default) -->
          <div id="quote-success-banner" class="hidden mt-4 p-4 rounded-2xl bg-purple-50 border border-purple-200 text-xs">
            <div class="flex items-center gap-2 text-purple-900 font-bold mb-2">
              <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
              <span>Quote Prepared for All 3 Founders!</span>
            </div>
            <p class="text-slate-600 mb-3">
              Your inquiry opened to Nidhith. You can also tap below to alert Naveen and Hemanth directly:
            </p>
            <div class="flex flex-wrap gap-2">
              <a id="notify-naveen-btn" href="#" target="_blank" class="px-3 py-1.5 rounded-lg bg-white border border-purple-200 hover:bg-purple-100 font-bold text-[11px] text-purple-800 flex items-center gap-1">
                WhatsApp Naveen
              </a>
              <a id="notify-hemanth-btn" href="#" target="_blank" class="px-3 py-1.5 rounded-lg bg-white border border-purple-200 hover:bg-purple-100 font-bold text-[11px] text-purple-800 flex items-center gap-1">
                WhatsApp Hemanth
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>

    <!-- ══════════════════════════════════════════════════════════════════
         CENTERED CINEMATIC INTRO VIDEO SHOWCASE (MAXIMUM SCALE & RESPONSIVE)
         ══════════════════════════════════════════════════════════════════ -->
    <div id="studio-reel" class="mt-16 sm:mt-20 lg:mt-24 w-full max-w-6xl xl:max-w-7xl mx-auto flex flex-col items-center justify-center">
      
      <!-- Video Section Header (Cleanly Centered) -->
      <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-8 px-4">
        <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-purple-900 bg-purple-100 border border-purple-200 px-4 py-1.5 rounded-full mb-3 shadow-sm">
          <span class="inline-block text-amber-500 animate-spin-slow">✦</span>
          <span>Official 4K Studio Commercial</span>
        </div>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-[#180f2d] font-display tracking-tight leading-tight">
          Watch TC Web & Studio <span class="text-gradient-purple-gold">In Action</span>
        </h2>
        <p class="text-xs sm:text-base text-[#4e4368] mt-2 font-sans max-w-2xl mx-auto">
          A direct look into the cinematic lighting, high-energy pacing, and conversion design we craft for businesses.
        </p>
      </div>

      <!-- Grand Cinema Theater Box (Fluid on Mobile/iOS, Huge on Desktop) -->
      <div class="w-full relative bg-white/95 rounded-2xl sm:rounded-3xl lg:rounded-[2.5rem] p-2 sm:p-4 lg:p-6 xl:p-7 border-2 border-purple-200/90 shadow-[0_20px_60px_-15px_rgba(109,40,217,0.20)] card-aesthetic-lift overflow-hidden">
        
        <!-- Ambient Cinema Glow behind the video (Expansive Desktop Glow) -->
        <div class="absolute -top-20 -left-20 w-80 h-80 lg:w-96 lg:h-96 bg-purple-400/25 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-20 -right-20 w-80 h-80 lg:w-96 lg:h-96 bg-amber-400/25 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Widescreen 16:9 Video Player Container -->
        <div class="relative w-full aspect-video rounded-xl sm:rounded-2xl lg:rounded-[1.75rem] overflow-hidden bg-black border border-purple-200/50 shadow-2xl group" style="transform: translateZ(0); -webkit-transform: translateZ(0);">
          
          <!-- iOS, Android, and Desktop Optimized Video Tag -->
          <video 
            id="intro-studio-video"
            class="w-full h-full object-cover"
            autoplay 
            muted 
            loop 
            playsinline
            webkit-playsinline
            x5-playsinline
            preload="auto"
            style="transform: translateZ(0); -webkit-transform: translateZ(0);"
          >
            <source src={`${basePath}/videos/intro.mp4`} type="video/mp4" />
            <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4" type="video/mp4" />
            Your browser does not support HTML5 video.
          </video>

          <!-- Top-Left Cinema Pill Tag -->
          <div class="absolute top-3 left-3 sm:top-5 sm:left-5 z-20 flex items-center gap-2 pointer-events-none">
            <span class="px-2.5 py-1 sm:px-3.5 sm:py-1.5 rounded-lg sm:rounded-xl bg-black/70 backdrop-blur-md text-[10px] sm:text-xs font-mono font-bold text-white border border-white/20 flex items-center gap-2 shadow-lg">
              <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
              <span>TC STUDIO COMMERCIAL • 29s</span>
            </span>
          </div>

          <!-- Bottom Control Bar (Touch-friendly 44px buttons for iOS & Mobile Thumb Comfort) -->
          <div class="absolute bottom-3 right-3 sm:bottom-5 sm:right-5 z-20 flex items-center gap-2 sm:gap-3">
            <!-- Fullscreen Button (Native iOS & Desktop Fullscreen) -->
            <button 
              type="button" 
              id="fullscreen-video-btn"
              class="min-h-[40px] sm:min-h-[44px] px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-black/75 hover:bg-black text-white backdrop-blur-md border border-white/20 text-xs sm:text-sm font-bold font-display flex items-center gap-1.5 sm:gap-2 transition-all shadow-lg cursor-pointer hover:scale-105 active:scale-95"
              aria-label="View Fullscreen"
              title="Watch Fullscreen"
            >
              <svg class="w-4 h-4 text-purple-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
              <span class="hidden sm:inline">Fullscreen</span>
            </button>

