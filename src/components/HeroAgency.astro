---
// HeroAgency.astro — Full-Service Digital Marketing Agency Hero Section
---

<section class="relative bg-gradient-to-b from-slate-50 via-blue-50/30 to-white text-slate-800 overflow-hidden pt-8 pb-16 lg:py-20 border-b border-slate-200/80" id="hero">
  
  <!-- Subtle Background Pattern -->
  <div class="absolute inset-0 bg-light-pattern opacity-60 pointer-events-none" aria-hidden="true"></div>
  
  <!-- Subtle Decorative Color Blurs -->
  <div class="absolute top-0 right-10 w-96 h-96 bg-blue-100/60 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 left-10 w-80 h-80 bg-orange-100/50 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      
      <!-- Left Column: Digital Marketing Agency Message -->
      <div class="lg:col-span-7">
        
        <!-- Live Status Badge -->
        <div class="inline-flex items-center gap-2.5 bg-white border border-slate-200 shadow-sm px-4 py-2 rounded-full text-xs font-bold mb-6">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
          </span>
          <span class="font-display tracking-wide uppercase text-[11px] text-slate-700">
            Full-Service Digital Marketing Agency • Mysuru
          </span>
          <span class="w-1 h-1 rounded-full bg-slate-300"></span>
          <span class="text-[11px] text-orange-600 font-mono font-bold">100% Founder-Led</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-[3.8rem] xl:text-[4.3rem] font-extrabold tracking-tight text-slate-900 mb-6 leading-[1.1] font-display">
          Digital Marketing Services in Mysuru That <br class="hidden sm:inline" />
          <span class="text-gradient-orange">Grow Traffic</span> & <br class="hidden sm:inline" />
          <span class="text-blue-600">Multiply Revenue.</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-600 mb-8 max-w-2xl leading-relaxed font-sans font-normal">
          Generate consistent qualified customer leads with full-funnel digital marketing. We craft ROI-driven Google & Meta ad campaigns, produce viral 4K video reels, build conversion-engineered web platforms, and dominate regional search rankings.
        </p>

        <!-- Proof Badges -->
        <div class="flex flex-wrap items-center gap-3 mb-9">
          <div class="px-4 py-2 bg-white border border-slate-200 rounded-xl flex items-center gap-2.5 shadow-sm text-xs font-bold text-slate-700">
            <span class="w-2 h-2 rounded-full bg-orange-500"></span>
            <span class="text-slate-900 font-extrabold font-display">3.5x</span>
            <span class="text-slate-500 font-medium">Average Marketing ROI</span>
          </div>

          <div class="px-4 py-2 bg-white border border-slate-200 rounded-xl flex items-center gap-2.5 shadow-sm text-xs font-bold text-slate-700">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            <span class="text-slate-900 font-extrabold font-display">4K Cinema</span>
            <span class="text-slate-500 font-medium">Ad & Reel Production</span>
          </div>

          <div class="px-4 py-2 bg-white border border-slate-200 rounded-xl flex items-center gap-2.5 shadow-sm text-xs font-bold text-slate-700">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-slate-900 font-extrabold font-display">Top #1–#3</span>
            <span class="text-slate-500 font-medium">Search & Map Dominance</span>
          </div>
        </div>

        <!-- Call to Action Buttons -->
        <div class="flex flex-wrap items-center gap-4">
          <button type="button" class="btn-cta-orange px-8 py-4 text-sm sm:text-base trigger-audit-modal font-bold">
            <span>Get A Free Digital Marketing Audit</span>
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>

          <a href="tel:+919741422544" class="btn-primary-agency text-sm sm:text-base py-4 px-6 flex items-center gap-2 font-bold">
            <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span>Call Founders: 97414 22544</span>
          </a>
        </div>

        <!-- Direct Founder WhatsApp Speed-Dial Strip -->
        <div class="mt-8 p-4 rounded-2xl bg-white/95 border border-slate-200/90 shadow-sm backdrop-blur-md max-w-xl">
          <div class="flex items-center justify-between mb-2.5 pb-2 border-b border-slate-100">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-600 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Direct Founder WhatsApp Speed-Dial:
            </span>
            <span class="text-[10px] font-mono font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">
              Average reply: &lt;15m
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <!-- Naveen -->
            <a 
              href="https://wa.me/919742963370?text=Hi%20Naveen%2C%20I%20would%20like%20to%20discuss%204K%20Commercial%20Video%20Shoots%20%26%20Reels%20for%20my%20business." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-2 p-2 rounded-xl bg-purple-50/70 hover:bg-purple-100/90 border border-purple-200/70 transition-all group"
              title="WhatsApp Naveen: 9742963370"
            >
              <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-purple-600 to-indigo-600 text-white font-extrabold text-xs flex items-center justify-center flex-shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                NV
              </span>
              <div class="truncate text-left">
                <div class="text-[11px] font-bold text-slate-900 group-hover:text-purple-700 truncate">Naveen</div>
                <div class="text-[9px] text-purple-700 font-semibold truncate">4K Films & Reels</div>
              </div>
            </a>

            <!-- Hemanth -->
            <a 
              href="https://wa.me/919741422544?text=Hi%20Hemanth%2C%20I%20would%20like%20to%20discuss%20Meta%20%26%20Google%20Paid%20Ad%20Campaigns%20for%20my%20business." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-2 p-2 rounded-xl bg-orange-50/70 hover:bg-orange-100/90 border border-orange-200/70 transition-all group"
              title="WhatsApp Hemanth: 9741422544"
            >
              <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-orange-600 to-amber-600 text-white font-extrabold text-xs flex items-center justify-center flex-shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                HM
              </span>
              <div class="truncate text-left">
                <div class="text-[11px] font-bold text-slate-900 group-hover:text-orange-700 truncate">Hemanth</div>
                <div class="text-[9px] text-orange-700 font-semibold truncate">Performance Ads</div>
              </div>
            </a>

            <!-- Nidhith -->
            <a 
              href="https://wa.me/918197974368?text=Hi%20Nidhith%2C%20I%20would%20like%20to%20discuss%20Web%20Architecture%20%26%20Content%20for%20my%20business." 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center gap-2 p-2 rounded-xl bg-blue-50/70 hover:bg-blue-100/90 border border-blue-200/70 transition-all group"
              title="WhatsApp Nidhith: 8197974368"
            >
              <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-blue-600 to-cyan-600 text-white font-extrabold text-xs flex items-center justify-center flex-shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                ND
              </span>
              <div class="truncate text-left">
                <div class="text-[11px] font-bold text-slate-900 group-hover:text-blue-700 truncate">Nidhith</div>
                <div class="text-[9px] text-blue-700 font-semibold truncate">Web & Growth</div>
              </div>
            </a>
          </div>
        </div>

        <!-- Social Proof Strip -->
        <div class="mt-7 pt-5 border-t border-slate-200 flex items-center gap-4 text-sm text-slate-600">
          <div class="flex text-amber-500 text-lg tracking-tighter">
            ★★★★★
          </div>
          <div class="text-xs sm:text-sm">
            <strong class="text-slate-900 font-bold">5.0 Star Marketing Rating</strong> from active Karnataka businesses including Jain Autocars & Saaraswath IAS.
          </div>
        </div>

      </div>

      <!-- Right Column: Prominent Digital Marketing Audit Intake Card -->
      <div class="lg:col-span-5">
        <div class="bg-white rounded-3xl border border-slate-200/90 shadow-2xl overflow-hidden card-luxury">
          
          <!-- Card Header Bar (Deep Navy Theme with subtle glow) -->
          <div class="bg-[#0f172a] text-white p-7 text-center relative overflow-hidden">
            <div class="absolute -top-10 -right-10 w-36 h-36 bg-blue-600/30 rounded-full blur-2xl pointer-events-none"></div>
            <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-orange-600/20 rounded-full blur-2xl pointer-events-none"></div>
            
            <span class="inline-flex items-center gap-1.5 bg-orange-500/20 text-orange-400 border border-orange-500/30 text-[10px] font-mono font-bold uppercase tracking-wider px-3.5 py-1 rounded-full mb-2">
              Actionable 24h Marketing Review
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold font-display text-white tracking-tight">
              Get A Free Marketing Audit
            </h2>
            <p class="text-xs text-slate-300 mt-1 max-w-xs mx-auto">
              Identify where you are losing customer leads across social ads, search, and website conversions.
            </p>
          </div>

          <!-- Form Body -->
          <div class="p-6 sm:p-8 bg-white">
            <form id="hero-audit-form" class="space-y-4">
              <div>
                <label for="hero-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                  Full Name *
                </label>
                <input 
                  type="text" 
                  id="hero-name" 
                  name="name" 
                  required 
                  placeholder="e.g. Anand Kumar"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 placeholder-slate-400 font-sans"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="hero-phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                    Phone / WhatsApp *
                  </label>
                  <input 
                    type="tel" 
                    id="hero-phone" 
                    name="phone" 
                    required 
                    placeholder="+91 97414 22544"
                    class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 placeholder-slate-400 font-sans"
                  />
                </div>

                <div>
                  <label for="hero-service" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                    Marketing Focus *
                  </label>
                  <select 
                    id="hero-service" 
                    name="service"
                    class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-800 font-sans cursor-pointer"
                  >
                    <option value="digital-marketing">360° Digital Marketing Sprint</option>
                    <option value="lead-ads">Meta & Google Paid Ad Campaigns</option>
                    <option value="video-social">4K Video Reels & Social Media</option>
                    <option value="web-funnel">Custom Web Platform & Funnels</option>
                    <option value="seo">Local Search & Google Maps</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="hero-website" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                  Website, Instagram or Business URL <span class="text-slate-400 font-normal lowercase">(optional)</span>
                </label>
                <input 
                  type="text" 
                  id="hero-website" 
                  name="website" 
                  placeholder="https://yourbrand.com or @instagram"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 placeholder-slate-400 font-sans"
                />
              </div>

              <button 
                type="submit" 
                class="w-full btn-cta-orange py-4 px-6 text-sm font-bold tracking-wide mt-2 justify-center shadow-lg transition-all cursor-pointer"
              >
                <span>Request Free Marketing Audit</span>
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>

              <div class="flex items-center justify-center gap-2 pt-1 text-[11px] text-slate-500">
                <svg class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>Instantly connects to founders Naveen, Hemanth & Nidhith.</span>
              </div>
            </form>

            <!-- Success Notification -->
            <div id="hero-audit-success" class="hidden mt-4 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs text-center">
              <span class="font-bold block text-sm mb-1">Marketing Audit Request Received!</span>
              <p class="mb-3">Opening WhatsApp with founders Naveen & Hemanth for direct priority consultation...</p>
              <a 
                id="hero-wa-direct-btn"
                href="https://wa.me/919741422544" 
                target="_blank" 
                rel="noopener noreferrer"
                class="btn-whatsapp-pill py-2.5 px-4 text-xs font-bold text-white inline-flex shadow-sm"
              >
                <span>Continue on WhatsApp →</span>
              </a>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const heroForm = document.getElementById('hero-audit-form') as HTMLFormElement | null;
  const heroSuccess = document.getElementById('hero-audit-success');
  const heroWaDirect = document.getElementById('hero-wa-direct-btn') as HTMLAnchorElement | null;

  if (heroForm && heroSuccess) {
    heroForm.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const formData = new FormData(heroForm);
      const name = (formData.get('name') as string) || '';
      const phone = (formData.get('phone') as string) || '';
      const service = (formData.get('service') as string) || 'digital-marketing';
      const website = (formData.get('website') as string) || '';

      // Route to relevant founder:
      // Naveen (9742963370) for video-social
      // Nidhith (8197974368) for web-funnel or seo
      // Hemanth (9741422544) for digital-marketing, lead-ads
      let targetPhone = "9741422544";
      let founderName = "Hemanth";
      if (service === 'video-social') {
        targetPhone = "9742963370";
        founderName = "Naveen";
      } else if (service === 'web-funnel' || service === 'seo') {
        targetPhone = "8197974368";
        founderName = "Nidhith";
      }

      const text = `Hi ${founderName}%20%26%20TC%20Web%20Studio%20Team%2C%20I%20requested%20a%20Free%20Digital%20Marketing%20Audit!%0A%0A*Name:*%20${encodeURIComponent(name)}%0A*Phone:*%20${encodeURIComponent(phone)}%0A*Focus:*%20${encodeURIComponent(service)}%0A*Website/Social:*%20${encodeURIComponent(website || 'None provided')}`;
      const waUrl = `https://wa.me/91${targetPhone}?text=${text}`;

      if (heroWaDirect) {
        heroWaDirect.href = waUrl;
      }

      heroForm.classList.add('opacity-50', 'pointer-events-none');
      
      // Auto-open WhatsApp redirect
      window.open(waUrl, '_blank');

      setTimeout(() => {
        heroForm.classList.add('hidden');
        heroSuccess.classList.remove('hidden');
      }, 500);
    });
  }
</script>
