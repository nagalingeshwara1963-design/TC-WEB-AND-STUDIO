---
// ClientResultsMetrics.astro — Verified Case Studies & Commercial Impact Proof (Light Corporate Edition)
const caseStudies = [
  {
    client: "Jain Autocars",
    category: "automotive",
    industry: "Automotive Dealership & Services • Mysuru",
    summary: "Jain Autocars required consistent local vehicle buyer inquiries and higher digital brand trust. We engineered a hyper-local Google SEO campaign, 4K vehicle video walkarounds, and automated WhatsApp lead ingestion.",
    metrics: [
      { value: "+140%", label: "Inbound Buyer Inquiries", color: "text-orange-600" },
      { value: "#1", label: "Google Maps 3-Pack Rank", color: "text-blue-600" },
      { value: "3.5x", label: "Commercial ROI Multiplier", color: "text-emerald-600" }
    ],
    deliverables: ["Hyper-Local SEO Domination", "Google Business Profile 3-Pack", "4K Vehicle Reel Production", "Instant WhatsApp Lead Funnel"]
  },
  {
    client: "Saaraswath IAS KAS Academy",
    category: "education",
    industry: "Civil Services & Competitive Exam Coaching • Karnataka",
    summary: "The academy needed to establish regional authority, simplify syllabus downloads, and attract prospective aspirants across Karnataka. We built a high-speed Astro platform with targeted SEO for competitive exam keywords.",
    metrics: [
      { value: "+210%", label: "Online Course Inquiries", color: "text-blue-600" },
      { value: "Top 3", label: "Google Keyword Ranks", color: "text-indigo-600" },
      { value: "0.3s", label: "Mobile Page Load Speed", color: "text-emerald-600" }
    ],
    deliverables: ["Custom Astro Platform", "Karnataka Syllabus Strategy", "Competitive Exam SEO", "Lead Ingestion System"]
  },
  {
    client: "Soulfull Academy",
    category: "creative",
    industry: "Creative Arts & Skill Development • Mysuru",
    summary: "Soulfull Academy sought to build an inspiring brand presence to attract aspiring creatives. Our team delivered a refined visual identity, social media campaign rollout, and high-production student showcase films.",
    metrics: [
      { value: "+95%", label: "Social Engagement Surge", color: "text-purple-600" },
      { value: "4K", label: "Ultra HD Cinema Shoots", color: "text-rose-600" },
      { value: "100%", label: "Consistent Weekly Output", color: "text-emerald-600" }
    ],
    deliverables: ["Brand Identity & Guidelines", "Weekly Social Media Reels", "Student Showcase Films", "Promotional Graphic Collateral"]
  },
  {
    client: "Manikanta Farms",
    category: "agriculture",
    industry: "Sustainable Agriculture & Organic Produce • Karnataka",
    summary: "Bridging the gap between organic farm harvests and urban consumers in Mysuru and Bengaluru. We created farm-to-table documentary visuals, transparent packaging design, and a direct WhatsApp catalog.",
    metrics: [
      { value: "+120%", label: "Direct Consumer Orders", color: "text-emerald-600" },
      { value: "0%", label: "Intermediary Commission Lost", color: "text-amber-600" },
      { value: "88%", label: "Repeat Order Retention", color: "text-teal-600" }
    ],
    deliverables: ["On-Site Farm Documentary", "Direct WhatsApp Commerce", "Product Packaging Concepts", "Regional Storytelling"]
  }
];
---

<section class="py-20 lg:py-28 bg-white border-b border-slate-200/80" id="case-studies">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 border border-emerald-200 px-4 py-1.5 rounded-full mb-3 font-display">
        Verified Outcomes
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 font-display leading-tight">
        Real Clients. Real Proof. <br />
        <span class="text-gradient-orange">Measurable Revenue Growth.</span>
      </h2>
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-sans">
        We refuse to hide behind vague vanity impressions. We judge every partnership by Google rankings, qualified phone inquiries, and confirmed customer revenue.
      </p>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      <button type="button" class="cs-filter-btn px-4 py-2 rounded-full text-xs font-bold border border-orange-500 bg-orange-600 text-white transition-all shadow-sm cursor-pointer" data-category="all">
        All Engagements (4)
      </button>
      <button type="button" class="cs-filter-btn px-4 py-2 rounded-full text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:text-slate-900 hover:border-slate-300 transition-all cursor-pointer" data-category="automotive">
        Automotive
      </button>
      <button type="button" class="cs-filter-btn px-4 py-2 rounded-full text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:text-slate-900 hover:border-slate-300 transition-all cursor-pointer" data-category="education">
        Education
      </button>
      <button type="button" class="cs-filter-btn px-4 py-2 rounded-full text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:text-slate-900 hover:border-slate-300 transition-all cursor-pointer" data-category="creative">
        Creative Academy
      </button>
      <button type="button" class="cs-filter-btn px-4 py-2 rounded-full text-xs font-bold border border-slate-200 bg-slate-50 text-slate-700 hover:text-slate-900 hover:border-slate-300 transition-all cursor-pointer" data-category="agriculture">
        Agriculture
      </button>
    </div>

    <!-- Case Studies Stack -->
    <div class="space-y-8" id="case-studies-container">
      {caseStudies.map((study, idx) => (
        <div class="cs-card card-light p-6 sm:p-10 transition-all duration-300 group" data-cat={study.category}>
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <!-- Left Info (7 Cols) -->
            <div class="lg:col-span-7">
              <div class="flex items-center gap-3 mb-3">
                <span class="w-8 h-8 rounded-lg bg-slate-100 text-slate-700 font-mono font-bold text-xs flex items-center justify-center border border-slate-200">
                  0{idx + 1}
                </span>
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500">
                  {study.industry}
                </span>
              </div>

              <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-4 font-display group-hover:text-blue-600 transition-colors">
                {study.client}
              </h3>

              <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6 font-sans">
                {study.summary}
              </p>

              <!-- Deliverable Badges -->
              <div class="flex flex-wrap gap-2 pt-2">
                {study.deliverables.map(del => (
                  <span class="text-xs font-mono bg-slate-100 text-slate-700 border border-slate-200 px-3 py-1 rounded-full font-medium">
                    ✓ {del}
                  </span>
                ))}
              </div>
            </div>

            <!-- Right Metrics Panel (5 Cols) -->
            <div class="lg:col-span-5">
              <div class="bg-slate-50 border border-slate-200/90 rounded-2xl p-6 shadow-sm">
                <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 mb-5 flex items-center justify-between border-b border-slate-200 pb-3">
                  <span>Verified Campaign Growth</span>
                  <span class="text-emerald-700 font-bold flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Audit-Backed
                  </span>
                </div>

                <div class="grid grid-cols-3 gap-3 text-center">
                  {study.metrics.map(metric => (
                    <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-sm">
                      <span class={`block text-2xl sm:text-3xl font-black font-display ${metric.color} tracking-tight`}>
                        {metric.value}
                      </span>
                      <span class="text-[11px] text-slate-600 font-medium block mt-1 leading-snug">
                        {metric.label}
                      </span>
                    </div>
                  ))}
                </div>

                <div class="mt-5 pt-4 border-t border-slate-200 text-center">
                  <button type="button" class="w-full btn-outline-light text-xs py-2.5 px-4 trigger-audit-modal cursor-pointer font-bold border-slate-300">
                    Request Similar Strategy Breakdown
                  </button>
                </div>
              </div>
            </div>

          </div>

        </div>
      ))}
    </div>

    <!-- Bottom Action -->
    <div class="mt-14 text-center">
      <button type="button" class="btn-cta-orange text-xs sm:text-sm py-4 px-8 trigger-audit-modal cursor-pointer font-bold shadow-md">
        <span>Request Your Custom ROI Audit</span>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </button>
    </div>

  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll('.cs-filter-btn');
  const cards = document.querySelectorAll('.cs-card');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => {
        b.classList.remove('border-orange-500', 'bg-orange-600', 'text-white', 'shadow-sm');
        b.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-700');
      });
      btn.classList.remove('border-slate-200', 'bg-slate-50', 'text-slate-700');
      btn.classList.add('border-orange-500', 'bg-orange-600', 'text-white', 'shadow-sm');

      const targetCategory = btn.getAttribute('data-category');

      cards.forEach(card => {
        const cardCat = card.getAttribute('data-cat');
        if (targetCategory === 'all' || cardCat === targetCategory) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
