---
// KeyStatsAndServices.astro — 6 Core Digital Marketing & Development Services
const services = [
  {
    id: "digital-marketing",
    title: "360° Digital Marketing & Performance Ads",
    desc: "Laser-targeted Meta & Google ad campaigns engineered for immediate inbound customer leads, high ROAS, and zero wasted ad spend.",
    icon: "📈",
    iconBg: "bg-orange-50 text-orange-600 border-orange-200",
    features: ["Meta & Instagram Lead Ads", "Google Search & High-Intent PPC", "Conversion-Engineered Ad Creatives", "Transparent Cost-Per-Lead (CPL) Tracking"],
    href: "#marketing"
  },
  {
    id: "web-development",
    title: "Custom High-Speed Web Development",
    desc: "Lightning-fast, bespoke websites built with modern Astro architecture. Engineered to convert visitors into phone calls & WhatsApp inquiries.",
    icon: "⚡",
    iconBg: "bg-blue-50 text-blue-600 border-blue-200",
    features: ["0.3s Mobile Load Times", "Touch-Optimized Responsive UI", "Direct WhatsApp & CRM Ingestion", "100/100 Lighthouse Performance"],
    href: "#web-development"
  },
  {
    id: "social-media",
    title: "4K Commercial Video & Viral Reels",
    desc: "In-house cinematic video shoots, drone walkthroughs, and viral social reels directed by Lead Filmmaker Naveen to build massive organic reach.",
    icon: "🎥",
    iconBg: "bg-purple-50 text-purple-600 border-purple-200",
    features: ["Ultra HD 4K Cinema Gear", "Viral 9:16 Reel Storyboarding", "Founder & Brand Documentaries", "Full Social Media Management"],
    href: "#social-media"
  },
  {
    id: "seo",
    title: "Organic Search & Google Maps (SEO)",
    desc: "Dominate Google Search and local Maps to capture ready-to-buy customers searching for your products in Mysuru and Karnataka.",
    icon: "🔍",
    iconBg: "bg-emerald-50 text-emerald-600 border-emerald-200",
    features: ["Google Maps 3-Pack Rankings", "High-Intent Keyword Dominance", "Technical Core Web Vitals", "Monthly Verified Rank Reports"],
    href: "#seo"
  },
  {
    id: "conversion-funnels",
    title: "Lead Conversion Funnels & Retargeting",
    desc: "Turn lost visitors into paying clients with intelligent multi-stage retargeting, automated WhatsApp workflows, and CRM lead routing.",
    icon: "🎯",
    iconBg: "bg-amber-50 text-amber-600 border-amber-200",
    features: ["Omni-Channel Retargeting", "WhatsApp Inbound Automation", "Landing Page A/B Testing", "Customer Lifetime Value Optimization"],
    href: "#marketing"
  },
  {
    id: "brand",
    title: "Brand Identity & Creative Direction",
    desc: "Bespoke logos, visual systems, and promotional posters that establish undeniable credibility and premium market perception.",
    icon: "🎨",
    iconBg: "bg-rose-50 text-rose-600 border-rose-200",
    features: ["Distinct Visual Identity Systems", "Marketing Posters & Banners", "Brand Messaging Guidelines", "Social Media Creative Templates"],
    href: "#social-media"
  }
];
---

<section class="py-20 lg:py-28 bg-[#f8fafc] border-b border-slate-200/80" id="services">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Digital Marketing First) -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 border border-blue-200 text-xs font-bold uppercase tracking-wider px-4 py-1.5 rounded-full mb-3 font-display">
        Full-Funnel Digital Marketing
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 font-display leading-tight">
        Comprehensive Digital Marketing Built to <span class="text-gradient-orange">Multiply Revenue</span>
      </h2>
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-sans">
        We engineer end-to-end customer acquisition systems: from laser-targeted Meta & Google ad campaigns and viral 4K video reels to lightning-fast web funnels and organic search dominance.
      </p>
    </div>

    <!-- 6 Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {services.map(svc => (
        <div class="card-light p-7 sm:p-8 flex flex-col justify-between group">
          <div>
            <!-- Icon & Quick Badge -->
            <div class="flex items-center justify-between mb-5">
              <div class={`w-12 h-12 rounded-xl flex items-center justify-center text-2xl border ${svc.iconBg} shadow-sm group-hover:scale-105 transition-transform`}>
                {svc.icon}
              </div>
              <a href={svc.href} class="text-xs font-bold text-slate-400 group-hover:text-blue-600 flex items-center gap-1 transition-colors font-display">
                <span>Learn Details</span>
                <span>→</span>
              </a>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-3 font-display leading-snug">
              {svc.title}
            </h3>

            <!-- Description -->
            <p class="text-slate-600 text-sm leading-relaxed mb-6 font-sans">
              {svc.desc}
            </p>

            <!-- Feature Bullets -->
            <ul class="space-y-2 mb-6 pt-4 border-t border-slate-100 text-xs text-slate-700 font-medium">
              {svc.features.map(feat => (
                <li class="flex items-center gap-2">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Button -->
          <div class="pt-2">
            <button 
              type="button" 
              class="w-full py-2.5 px-4 rounded-xl border border-slate-200 hover:border-blue-500 bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-blue-700 font-bold text-xs transition-all flex items-center justify-center gap-1 trigger-audit-modal cursor-pointer font-display"
            >
              <span>Get Free Marketing Review</span>
              <span>→</span>
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Banner Callout -->
    <div class="mt-16 bg-white border border-slate-200/90 rounded-3xl p-8 sm:p-10 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold text-slate-900 font-display">
          Need a High-ROI Digital Marketing Strategy for Your Business?
        </h3>
        <p class="text-slate-600 text-sm mt-1">
          Our founders will personally review your ad spend, social presence, and conversion funnels to draft a 90-day growth plan.
        </p>
      </div>
      <div class="flex items-center gap-3 flex-shrink-0">
        <button type="button" class="btn-cta-orange text-xs py-3.5 px-6 trigger-audit-modal font-bold">
          Request Marketing Audit
        </button>
      </div>
    </div>

  </div>
</section>
