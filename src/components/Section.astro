---
interface Props {
  id?: string;
  class?: string;
  yPadding?: "none" | "sm" | "md" | "lg" | "xl";
  xPadding?: boolean;
}

const { 
  id, 
  class: className = "", 
  yPadding = "lg",
  xPadding = true 
} = Astro.props;

const paddingStyles = {
  none: "",
  sm: "py-8 md:py-16",
  md: "py-16 md:py-24",
  lg: "py-24 md:py-32",
  xl: "py-32 md:py-48"
};

const xStyles = xPadding ? "px-6 md:px-12 lg:px-20" : "";
---

<section id={id} class:list={[`w-full max-w-[1920px] mx-auto`, paddingStyles[yPadding], xStyles, className]}>
  <slot />
</section>
