---
// Navbar.astro — Clean white navigation with crisp corporate typography
---

<nav class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-all duration-300" id="main-nav">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-[4.75rem]">
      
      <!-- Brand Mark -->
      <a href="/" class="flex items-center gap-3.5 group focus:outline-none" aria-label="TC Web & Studio Home">
        <div class="relative w-11 h-11 rounded-xl bg-gradient-to-br from-[#ea580c] to-[#f97316] flex items-center justify-center text-white font-extrabold text-lg shadow-md group-hover:shadow-lg group-hover:scale-105 transition-all duration-200 font-display">
          TC
          <span class="absolute -top-0.5 -right-0.5 w-3 h-3 bg-emerald-500 border-2 border-white rounded-full"></span>
        </div>
        <div>
          <span class="block text-xl font-extrabold tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors font-display">
            TC Web & Studio
          </span>
          <span class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest font-mono">
            Digital Marketing & Web • Mysuru
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <div class="hidden lg:flex items-center gap-1 bg-slate-100/70 border border-slate-200/80 rounded-full px-2 py-1">
        <a href="#services" class="nav-link px-4 py-2 text-xs font-bold text-slate-700 hover:text-blue-600 hover:bg-white rounded-full transition-all">
          Services
        </a>
        <a href="#case-studies" class="nav-link px-4 py-2 text-xs font-bold text-slate-700 hover:text-blue-600 hover:bg-white rounded-full transition-all">
          Results & Proof
        </a>
        <a href="#calculator" class="nav-link px-4 py-2 text-xs font-bold text-orange-600 hover:text-orange-700 hover:bg-orange-50/80 rounded-full transition-all flex items-center gap-1.5">
          ROI Calculator
          <span class="w-1.5 h-1.5 rounded-full bg-orange-600 animate-pulse"></span>
        </a>
        <a href="#how-we-work" class="nav-link px-4 py-2 text-xs font-bold text-slate-700 hover:text-blue-600 hover:bg-white rounded-full transition-all">
          Process
        </a>
        <a href="#industries" class="nav-link px-4 py-2 text-xs font-bold text-slate-700 hover:text-blue-600 hover:bg-white rounded-full transition-all">
          Industries
        </a>
        <a href="#studio" class="nav-link px-4 py-2 text-xs font-bold text-slate-700 hover:text-blue-600 hover:bg-white rounded-full transition-all">
          Founders
        </a>
        <a href="#contact" class="nav-link px-4 py-2 text-xs font-bold text-slate-700 hover:text-blue-600 hover:bg-white rounded-full transition-all">
          Contact
        </a>
      </div>

      <!-- Desktop Action Buttons -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="tel:+919741422544" class="btn-outline-light text-xs py-2.5 px-4 font-bold border-slate-300 text-slate-800 hover:bg-slate-50">
          <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          Call Direct: 97414 22544
        </a>

        <button 
          type="button"
          class="btn-cta-orange text-xs py-2.5 px-5 trigger-audit-modal cursor-pointer font-bold"
          aria-label="Open free digital marketing audit modal"
        >
          <span>Free Marketing Audit</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center gap-2 lg:hidden">
        <button type="button" class="btn-cta-orange text-xs py-2 px-3.5 trigger-audit-modal font-bold">
          Free Audit
        </button>

        <button 
          type="button" 
          id="mobile-nav-toggle"
          class="p-2.5 text-slate-700 hover:text-slate-900 bg-slate-100 border border-slate-200 rounded-xl focus:outline-none transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-nav-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-6 pt-4 pb-8 space-y-2 shadow-xl">
    <a href="#services" class="mobile-link block px-4 py-3 text-base font-bold text-slate-800 hover:text-blue-600 hover:bg-slate-50 rounded-xl transition-all">
      Services
    </a>
    <a href="#calculator" class="mobile-link block px-4 py-3 text-base font-bold text-orange-600 hover:bg-orange-50 rounded-xl transition-all flex items-center justify-between">
      <span>ROI Calculator</span>
      <span class="text-[10px] bg-orange-100 text-orange-700 px-2 py-0.5 rounded-full font-mono font-bold">CALCULATE</span>
    </a>
    <a href="#case-studies" class="mobile-link block px-4 py-3 text-base font-bold text-slate-800 hover:text-blue-600 hover:bg-slate-50 rounded-xl transition-all">
      Client Results & Proof
    </a>
    <a href="#how-we-work" class="mobile-link block px-4 py-3 text-base font-bold text-slate-800 hover:text-blue-600 hover:bg-slate-50 rounded-xl transition-all">
      How We Work
    </a>
    <a href="#industries" class="mobile-link block px-4 py-3 text-base font-bold text-slate-800 hover:text-blue-600 hover:bg-slate-50 rounded-xl transition-all">
      Industries Served
    </a>
    <a href="#studio" class="mobile-link block px-4 py-3 text-base font-bold text-slate-800 hover:text-blue-600 hover:bg-slate-50 rounded-xl transition-all">
      Founders & Leadership
    </a>
    <a href="#contact" class="mobile-link block px-4 py-3 text-base font-bold text-slate-800 hover:text-blue-600 hover:bg-slate-50 rounded-xl transition-all">
      Contact & Location
    </a>

    <div class="pt-5 border-t border-slate-200 flex flex-col gap-3 mt-2">
      <button type="button" class="w-full btn-cta-orange text-center trigger-audit-modal py-3.5 text-sm font-bold">
        Free Digital Marketing Audit
      </button>
      <a href="tel:+919741422544" class="w-full btn-outline-light text-center text-sm py-3 font-bold border-slate-300">
        Call Mysuru Studio: +91 97414 22544
      </a>
    </div>
  </div>
</nav>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const menu = document.getElementById('mobile-nav-menu');
  const hamburger = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (toggleBtn && menu && hamburger && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.remove('hidden');
        hamburger.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });

    document.querySelectorAll('.mobile-link').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        hamburger.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Navbar subtle scroll shadow
  const nav = document.getElementById('main-nav');
  if (nav) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        nav.classList.add('shadow-md');
      } else {
        nav.classList.remove('shadow-md');
      }
    }, { passive: true });
  }
</script>
