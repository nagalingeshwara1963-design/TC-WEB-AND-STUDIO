---
// LocationAndContact.astro — Studio Location & Direct Inquiry Section (Light Corporate Edition)
---

<section class="py-20 lg:py-28 bg-[#f8fafc] border-b border-slate-200/80" id="contact">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-blue-700 bg-blue-50 border border-blue-200 px-4 py-1.5 rounded-full mb-3 font-display">
        Get In Touch
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 font-display leading-tight">
        Visit Our Mysuru Studio or <br />
        <span class="text-gradient-orange">Schedule a Growth Call</span>
      </h2>
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-sans">
        Have an upcoming project or want to analyze your local search competition? Fill out the brief below or speak directly with our team.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Contact Details & Map Embed (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Contact Cards -->
        <div class="card-light p-6">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center text-xl flex-shrink-0 border border-orange-200">
              📍
            </div>
            <div>
              <span class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-400 mb-1">Studio Location</span>
              <h3 class="text-base font-bold text-slate-900 font-display">
                TC Web & Studio
              </h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Kuvempunagar / Saraswathipuram, Mysuru, Karnataka 570009
              </p>
            </div>
          </div>
        </div>

        <!-- Founders Direct Line Directory -->
        <div class="card-light p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div>
              <span class="block text-[11px] font-mono font-bold uppercase tracking-wider text-orange-600">Direct Accountability</span>
              <h3 class="text-base font-bold text-slate-900 font-display">Talk Directly With Founders</h3>
            </div>
            <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full font-mono">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Live Direct
            </span>
          </div>

          <!-- Naveen Contact Row -->
          <div class="p-3 rounded-2xl bg-purple-50/50 border border-purple-100 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-600 to-indigo-600 text-white font-extrabold text-xs flex items-center justify-center font-display shadow-sm flex-shrink-0">
                NV
              </div>
              <div>
                <div class="text-xs font-bold text-slate-900 font-display">Naveen</div>
                <div class="text-[10px] text-purple-700 font-semibold">4K Video Shoots & Reels</div>
                <div class="text-[11px] font-mono font-bold text-slate-700">+91 97429 63370</div>
              </div>
            </div>
            <div class="flex items-center gap-1.5 flex-shrink-0">
              <a 
                href="https://wa.me/919742963370?text=Hi%20Naveen%2C%20I%20would%20like%20to%20discuss%204K%20Commercial%20Video%20Shoots%20%26%20Reels." 
