---
// LocationAndContact.astro — Studio Location & Direct Inquiry Section (Light Corporate Edition)
---

<section class="py-20 lg:py-28 bg-[#f8fafc] border-b border-slate-200/80" id="contact">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-blue-700 bg-blue-50 border border-blue-200 px-4 py-1.5 rounded-full mb-3 font-display">
        Get In Touch
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 font-display leading-tight">
        Visit Our Mysuru Studio or <br />
        <span class="text-gradient-orange">Schedule a Growth Call</span>
      </h2>
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-sans">
        Have an upcoming project or want to analyze your local search competition? Fill out the brief below or speak directly with our team.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Contact Details & Map Embed (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Contact Cards -->
        <div class="card-light p-6">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center text-xl flex-shrink-0 border border-orange-200">
              📍
            </div>
            <div>
              <span class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-400 mb-1">Studio Location</span>
              <h3 class="text-base font-bold text-slate-900 font-display">
                TC Web & Studio
              </h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                Kuvempunagar / Saraswathipuram, Mysuru, Karnataka 570009
              </p>
            </div>
          </div>
        </div>

        <div class="card-light p-6">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl flex-shrink-0 border border-blue-200">
              📞
            </div>
            <div>
              <span class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-400 mb-1">Direct Telephone</span>
              <a href="tel:+919876543210" class="text-base font-bold text-slate-900 hover:text-blue-600 font-display block">
                +91 98765 43210
              </a>
              <span class="text-xs text-slate-500 mt-1 block">Mon–Sat: 9:30 AM – 7:00 PM IST</span>
            </div>
          </div>
        </div>

        <div class="card-light p-6">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl flex-shrink-0 border border-emerald-200">
              💬
            </div>
            <div>
              <span class="block text-xs font-mono font-bold uppercase tracking-wider text-slate-400 mb-1">Instant WhatsApp</span>
              <a href="https://wa.me/919876543210?text=Hi%20TC%20Web%20%26%20Studio%2C%20I%20would%20like%20to%20discuss%20a%20project." target="_blank" rel="noopener noreferrer" class="text-base font-bold text-emerald-700 hover:text-emerald-800 font-display block">
                Chat Directly on WhatsApp →
              </a>
              <span class="text-xs text-slate-500 mt-1 block">Average reply time: under 15 minutes</span>
            </div>
          </div>
        </div>

        <!-- Google Maps Embed Card -->
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
          <div class="p-3.5 bg-slate-100 border-b border-slate-200 flex items-center justify-between text-xs font-bold text-slate-700 font-display">
            <span>Mysuru Studio Location</span>
            <span class="text-emerald-600 font-mono text-[11px]">Open for Appointments</span>
          </div>
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d124741.01859664448!2d76.565649!3d12.310636!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3baf70381d572ef9%3A0x2b89e8c2776c5b70!2sMysuru%2C%20Karnataka!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin" 
            width="100%" 
            height="220" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="TC Web & Studio Mysuru Office Map"
          ></iframe>
        </div>

      </div>

      <!-- Right Column: Full Inquiry Form (7 Cols) -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-lg">
          <div class="mb-6">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-orange-600">
              Direct Intake Form
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-display mt-1">
              Start Your Project Discussion
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
              Tell us about your business goals and we will prepare a tailored proposal.
            </p>
          </div>

          <form id="contact-inquiry-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                  Your Full Name *
                </label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name" 
                  required 
                  placeholder="e.g. Suresh Gowda"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 font-sans"
                />
              </div>

              <div>
                <label for="contact-phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                  Phone / WhatsApp *
                </label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  name="phone" 
                  required 
                  placeholder="+91 98765 43210"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 font-sans"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                  Email Address *
                </label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="email" 
                  required 
                  placeholder="name@company.com"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 font-sans"
                />
              </div>

              <div>
                <label for="contact-service" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                  Service Required
                </label>
                <select 
                  id="contact-service" 
                  name="service"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-800 font-sans cursor-pointer"
                >
                  <option value="seo">Search Engine Optimization (SEO)</option>
                  <option value="web">Custom High-Speed Website</option>
                  <option value="video">4K Video Reels & Commercials</option>
                  <option value="branding">Brand Identity & Social Media</option>
                  <option value="full">Comprehensive Growth Package</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-website" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                Current Website or Google Maps URL <span class="text-slate-400 font-normal lowercase">(if any)</span>
              </label>
              <input 
                type="text" 
                id="contact-website" 
                name="website" 
                placeholder="https://yourbrand.com"
                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 font-sans"
              />
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                Tell Us About Your Goals
              </label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="3"
                placeholder="Describe your target audience, main competitors, or immediate milestones..."
                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 font-sans"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full btn-cta-orange py-4 px-6 text-sm font-bold tracking-wide mt-2 justify-center shadow-lg cursor-pointer"
            >
              <span>Submit Project Inquiry</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>

            <div class="flex items-center justify-center gap-2 pt-2 text-xs text-slate-500">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Guaranteed founder reply within 4 business hours. No aggressive sales pitching.</span>
            </div>
          </form>

          <!-- Success Notification -->
          <div id="contact-success" class="hidden mt-4 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs text-center">
            <span class="font-bold block text-sm mb-1">Inquiry Dispatched Successfully!</span>
            Naveen or Hemanth will review your requirements and reach out via phone/WhatsApp today.
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-inquiry-form');
  const contactSuccess = document.getElementById('contact-success');

  if (contactForm && contactSuccess) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      contactForm.classList.add('opacity-50', 'pointer-events-none');
      
      setTimeout(() => {
        contactForm.classList.add('hidden');
        contactSuccess.classList.remove('hidden');
      }, 600);
    });
  }
</script>
