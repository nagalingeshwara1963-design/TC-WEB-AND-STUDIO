          <!-- Hemanth Contact Row -->
          <div class="p-3 rounded-2xl bg-orange-50/50 border border-orange-100 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-orange-600 to-amber-600 text-white font-extrabold text-xs flex items-center justify-center font-display shadow-sm flex-shrink-0">
                HM
              </div>
              <div>
                <div class="text-xs font-bold text-slate-900 font-display">Hemanth</div>
                <div class="text-[10px] text-orange-700 font-semibold">Meta & Google Ads • ROAS</div>
                <div class="text-[11px] font-mono font-bold text-slate-700">+91 97414 22544</div>
              </div>
            </div>
            <div class="flex items-center gap-1.5 flex-shrink-0">
              <a 
                href="https://wa.me/919741422544?text=Hi%20Hemanth%2C%20I%20would%20like%20to%20discuss%20Meta%20%26%20Google%20Paid%20Ad%20Campaigns." 
                target="_blank" 
                rel="noopener noreferrer" 
                class="p-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-all"
                title="WhatsApp Hemanth (9741422544)"
                aria-label="WhatsApp Hemanth"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              </a>
              <a 
                href="tel:+919741422544" 
                class="p-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shadow-sm transition-all"
                title="Call Hemanth"
                aria-label="Call Hemanth"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </a>
            </div>
          </div>

          <!-- Nidhith Contact Row -->
          <div class="p-3 rounded-2xl bg-blue-50/50 border border-blue-100 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-600 text-white font-extrabold text-xs flex items-center justify-center font-display shadow-sm flex-shrink-0">
                ND
              </div>
              <div>
                <div class="text-xs font-bold text-slate-900 font-display">Nidhith</div>
                <div class="text-[10px] text-blue-700 font-semibold">Web Architect & SEO</div>
                <div class="text-[11px] font-mono font-bold text-slate-700">+91 81979 74368</div>
              </div>
            </div>
            <div class="flex items-center gap-1.5 flex-shrink-0">
              <a 
                href="https://wa.me/918197974368?text=Hi%20Nidhith%2C%20I%20would%20like%20to%20discuss%20Web%20Architecture%20%26%20SEO." 
                target="_blank" 
                rel="noopener noreferrer" 
                class="p-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-all"
                title="WhatsApp Nidhith (8197974368)"
                aria-label="WhatsApp Nidhith"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              </a>
              <a 
                href="tel:+918197974368" 
                class="p-2 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 shadow-sm transition-all"
                title="Call Nidhith"
                aria-label="Call Nidhith"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Google Maps Embed Card -->
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
          <div class="p-3.5 bg-slate-100 border-b border-slate-200 flex items-center justify-between text-xs font-bold text-slate-700 font-display">
            <span>Mysuru Studio Location</span>
            <span class="text-emerald-600 font-mono text-[11px]">Open for Appointments</span>
          </div>
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d124741.01859664448!2d76.565649!3d12.310636!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3baf70381d572ef9%3A0x2b89e8c2776c5b70!2sMysuru%2C%20Karnataka!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin" 
            width="100%" 
            height="220" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="TC Web & Studio Mysuru Office Map"
          ></iframe>
        </div>

      </div>

      <!-- Right Column: Full Inquiry Form (7 Cols) -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-lg">
          <div class="mb-6">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-orange-600">
              Direct Digital Marketing Intake
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-display mt-1">
              Submit Your Digital Marketing Query
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-1">
              Tell us about your business goals and our founders will analyze your growth potential and prepare a tailored strategy.
            </p>
          </div>

          <form id="contact-inquiry-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                  Your Full Name *
                </label>
                <input 
                  type="text" 
                  id="contact-name" 
                  name="name" 
                  required 
                  placeholder="e.g. Suresh Gowda"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 font-sans"
                />
              </div>

              <div>
                <label for="contact-phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                  Phone / WhatsApp *
                </label>
                <input 
                  type="tel" 
                  id="contact-phone" 
                  name="phone" 
                  required 
                  placeholder="+91 97414 22544"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 font-sans"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                  Email Address *
                </label>
                <input 
                  type="email" 
                  id="contact-email" 
                  name="email" 
                  required 
                  placeholder="name@company.com"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 font-sans"
                />
              </div>

              <div>
                <label for="contact-service" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                  Primary Service Needed
                </label>
                <select 
                  id="contact-service" 
                  name="service"
                  class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-800 font-sans cursor-pointer"
                >
                  <option value="digital-marketing">360° Digital Marketing & Performance Paid Ads</option>
                  <option value="social-growth">Social Media Management & 4K Viral Reels</option>
                  <option value="web">Custom High-Speed Website & Landing Funnels</option>
                  <option value="seo">Local Search & Google Maps Optimization</option>
                  <option value="branding">Brand Identity, Logo & Creative Direction</option>
                  <option value="full">Full-Funnel Monthly Growth Retainer</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-website" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                Current Website, Instagram or Google Maps URL <span class="text-slate-400 font-normal lowercase">(if any)</span>
              </label>
              <input 
                type="text" 
                id="contact-website" 
                name="website" 
                placeholder="https://yourbrand.com or @handle"
                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 font-sans"
              />
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5 font-display">
                Tell Us About Your Marketing Goals
              </label>
              <textarea 
                id="contact-message" 
                name="message" 
                rows="3" 
                placeholder="Describe your target customers, monthly marketing budget, or main revenue milestones..."
                class="w-full px-4 py-3 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white focus:outline-none transition-all text-slate-900 font-sans"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full btn-cta-orange py-4 px-6 text-sm font-bold tracking-wide mt-2 justify-center shadow-lg cursor-pointer"
            >
              <span>Submit Digital Marketing Query</span>
              <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>

            <div class="flex items-center justify-center gap-2 pt-2 text-xs text-slate-500">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Direct routing to Naveen, Hemanth or Nidhith. Under 15m WhatsApp response.</span>
            </div>
          </form>

          <!-- Success Notification -->
          <div id="contact-success" class="hidden mt-4 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs text-center">
            <span class="font-bold block text-sm mb-1">Inquiry Dispatched Successfully!</span>
            <p class="mb-3">Redirecting to WhatsApp with your chosen founder for direct strategy consultation...</p>
            <a 
              id="contact-wa-direct-btn"
              href="https://wa.me/919741422544" 
              target="_blank" 
              rel="noopener noreferrer"
              class="btn-whatsapp-pill py-2.5 px-4 text-xs font-bold text-white inline-flex shadow-sm"
            >
              <span>Continue to WhatsApp Chat →</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const contactForm = document.getElementById('contact-inquiry-form') as HTMLFormElement | null;
  const contactSuccess = document.getElementById('contact-success');
  const contactWaDirect = document.getElementById('contact-wa-direct-btn') as HTMLAnchorElement | null;

  if (contactForm && contactSuccess) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const formData = new FormData(contactForm);
      const name = (formData.get('name') as string) || '';
      const phone = (formData.get('phone') as string) || '';
      const email = (formData.get('email') as string) || '';
      const service = (formData.get('service') as string) || 'digital-marketing';
      const website = (formData.get('website') as string) || '';
      const message = (formData.get('message') as string) || '';

      // Route by service:
      // social-growth, branding -> Naveen (9742963370)
      // web, seo -> Nidhith (8197974368)
      // digital-marketing, full -> Hemanth (9741422544)
      let targetPhone = "9741422544";
      let founderName = "Hemanth";
      if (service === 'social-growth' || service === 'branding') {
        targetPhone = "9742963370";
        founderName = "Naveen";
      } else if (service === 'web' || service === 'seo') {
        targetPhone = "8197974368";
        founderName = "Nidhith";
      }

      const text = `Hi ${founderName}%20%26%20TC%20Web%20Studio%2C%20I%20submitted%20a%20project%20inquiry!%0A%0A*Name:*%20${encodeURIComponent(name)}%0A*Phone:*%20${encodeURIComponent(phone)}%0A*Email:*%20${encodeURIComponent(email)}%0A*Service:*%20${encodeURIComponent(service)}%0A*Website:*%20${encodeURIComponent(website || 'None')}%0A*Notes:*%20${encodeURIComponent(message || 'Looking for growth strategy')}`;
      const waUrl = `https://wa.me/91${targetPhone}?text=${text}`;

      if (contactWaDirect) {
        contactWaDirect.href = waUrl;
      }

      contactForm.classList.add('opacity-50', 'pointer-events-none');
      
      // Auto-open WhatsApp redirect
      window.open(waUrl, '_blank');

      setTimeout(() => {
        contactForm.classList.add('hidden');
        contactSuccess.classList.remove('hidden');
      }, 500);
    });
  }
</script>
