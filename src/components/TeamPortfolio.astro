        <div class="flex items-center gap-4">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden border-2 border-purple-300 shadow-md shadow-purple-600/20 group-hover:scale-105 transition-transform shrink-0">
            <img 
              src={`${basePath}/images/founders/naveen.jpg`} 
              alt="Naveen — Creative Director & Lead Filmmaker" 
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-2xl font-extrabold text-[#180f2d] font-display">
                Naveen
              </h3>
              <span class="text-[10px] font-mono font-bold uppercase bg-purple-100 text-purple-800 px-2.5 py-0.5 rounded-full">
                Video Lead
              </span>
            </div>
            <p class="text-xs sm:text-sm font-semibold text-[#5a4f73] mt-0.5">
              Creative Director & Lead Filmmaker • 4K Commercials & Viral Reels
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <a 
            href="tel:+919742963370" 
            class="px-4 py-2 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 text-xs font-bold font-display transition-all flex items-center gap-1.5"
            title="Call Naveen directly"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
