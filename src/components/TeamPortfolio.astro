<!-- Script for individual loop video audio toggles -->
<script>
  document.querySelectorAll('.video-sound-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const container = (e.currentTarget as HTMLElement).closest('.group');
      const vid = container?.querySelector('video') as HTMLVideoElement | null;
      if (vid) {
        if (vid.muted) {
          vid.muted = false;
          (e.currentTarget as HTMLElement).innerHTML = '<span>🔇 Mute</span>';
          (e.currentTarget as HTMLElement).classList.add('bg-emerald-600');
        } else {
          vid.muted = true;
          (e.currentTarget as HTMLElement).innerHTML = '<span>🔊 Audio</span>';
          (e.currentTarget as HTMLElement).classList.remove('bg-emerald-600');
        }
      }
    });
  });
</script>
