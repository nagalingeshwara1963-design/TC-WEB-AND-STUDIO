            <p class="text-xs text-[#5e5377] mt-0.5">
              Hook-driven 4K cinematography engineered for Instagram engagement.
            </p>
            <span class="inline-block mt-2 text-[10px] font-mono text-purple-700 bg-purple-50 px-2 py-0.5 rounded border border-purple-200">
              Drop file: /videos/naveen-1.mp4
            </span>
          </div>
        </div>

        <!-- Video Card 2 -->
        <div class="rounded-2xl overflow-hidden bg-slate-900 border border-purple-200 shadow-sm flex flex-col group">
