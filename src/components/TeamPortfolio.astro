            <button 
              type="button" 
              class="video-sound-btn absolute bottom-3 right-3 px-2.5 py-1 rounded-lg bg-black/70 hover:bg-black text-white text-[11px] font-mono flex items-center gap-1.5 transition-all cursor-pointer backdrop-blur-sm"
              aria-label="Toggle sound"
            >
              <span>🔊 Audio</span>
