---
// TeamPortfolio.astro — Individual Founder Portfolios
// Naveen: Loop videos
// Nidhith: Poster works
// Hemanth: Web designs
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="py-20 lg:py-28 bg-[#faf8ff] bg-subtle-grid border-b border-purple-200/60" id="portfolio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-purple-900 bg-purple-100 border border-purple-200 px-4 py-1.5 rounded-full mb-3 font-display shadow-sm">
        <span class="inline-block text-amber-500 animate-spin-slow">✦</span>
        <span>Team Portfolio & Work</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#180f2d] tracking-tight mb-4 font-display leading-tight">
        Explore Work by <span class="text-gradient-purple-gold">Our Three Founders</span>
      </h2>
      <p class="text-[#4e4368] text-base sm:text-lg leading-relaxed font-sans">
        Every project is personally built by our founding team. Here is what Naveen films, what Nidhith designs, and what Hemanth engineers.
      </p>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════
         FOUNDER 1: NAVEEN — VIDEO PRODUCTION & COMMERCIAL REELS (LOOP)
         ══════════════════════════════════════════════════════════════════ -->
