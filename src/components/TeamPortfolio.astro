          <div class="relative aspect-[9/16] bg-black overflow-hidden">
            <!-- Naveen Reel Video Slot 1 (Auto plays in loop, muted by default) -->
            <video 
              class="w-full h-full object-cover loop-video"
              autoplay 
              muted 
              loop 
              playsinline
              preload="metadata"
            >
              <source src={`${basePath}/videos/naveen-1.mp4`} type="video/mp4" />
