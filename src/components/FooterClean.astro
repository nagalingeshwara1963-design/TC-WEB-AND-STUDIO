---
// FooterClean.astro — Clean light purple tint & gold agency footer
---

<footer class="bg-white border-t border-purple-200/80 pt-16 pb-12 text-[#3c3250]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 pb-12 border-b border-purple-100">
      
      <!-- Brand & Story Column -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-700 to-amber-600 flex items-center justify-center text-white font-extrabold text-base shadow-sm font-display border border-amber-300/40">
            TC
          </div>
          <div>
            <span class="block text-lg font-extrabold text-[#1c1335] font-display">
              TC WEB & STUDIO
            </span>
            <span class="block text-[10px] font-bold text-amber-700 uppercase tracking-widest font-mono">
              Mysuru, Karnataka
            </span>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-[#5e5377] leading-relaxed max-w-sm">
          A dedicated 3-founder studio engineered to deliver high-converting digital marketing, bespoke web platforms, 4K commercial reels, and striking poster designs. Budget-friendly, transparent, and skill-driven.
        </p>

        <div class="pt-2">
          <a 
            href="https://wa.me/918197974368?text=Hi%20Nidhith!%20I%20would%20like%20to%20discuss%20a%20project%20with%20TC%20Web%20%26%20Studio."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-600 text-emerald-800 hover:text-white border border-emerald-200 text-xs font-bold transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            <span>WhatsApp Lead Desk: +91 81979 74368</span>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#1c1335] font-display">
          Website Sections
        </h4>
        <ul class="text-xs space-y-2 font-medium">
          <li><a href="#about" class="text-slate-600 hover:text-purple-700 transition-colors">About Us (The Company)</a></li>
          <li><a href="#portfolio" class="text-slate-600 hover:text-purple-700 transition-colors">Team Portfolio (Founder Works)</a></li>
          <li><a href="#clients" class="text-slate-600 hover:text-purple-700 transition-colors">Previous & Current Clients</a></li>
          <li><a href="#services" class="text-slate-600 hover:text-purple-700 transition-colors">All Studio Services</a></li>
          <li><a href="#prices" class="text-amber-800 hover:text-amber-900 font-semibold transition-colors">Our Prices (Custom to Budget)</a></li>
          <li><a href="#contact" class="text-slate-600 hover:text-purple-700 transition-colors">Contact Founders</a></li>
        </ul>
      </div>

      <!-- Direct Founders Contact -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-[#1c1335] font-display">
          Direct Founder Numbers
        </h4>
        <div class="space-y-2 text-xs">
          <div class="p-2.5 rounded-xl bg-purple-50/60 border border-purple-100 flex items-center justify-between">
            <div>
              <strong class="text-purple-950 font-display">Naveen</strong>
              <span class="text-[11px] text-slate-500 block">Video Production & Reels</span>
            </div>
            <a href="tel:+919742963370" class="font-mono font-bold text-purple-700 hover:underline">+91 97429 63370</a>
          </div>

          <div class="p-2.5 rounded-xl bg-amber-50/60 border border-amber-100 flex items-center justify-between">
            <div>
              <strong class="text-amber-950 font-display">Nidhith</strong>
              <span class="text-[11px] text-slate-500 block">Visual Posters & Brand Identity</span>
            </div>
            <a href="tel:+918197974368" class="font-mono font-bold text-amber-800 hover:underline">+91 81979 74368</a>
          </div>

          <div class="p-2.5 rounded-xl bg-purple-50/60 border border-purple-100 flex items-center justify-between">
            <div>
              <strong class="text-purple-950 font-display">Hemanth</strong>
              <span class="text-[11px] text-slate-500 block">Web Development & Paid Ads</span>
            </div>
            <a href="tel:+919741422544" class="font-mono font-bold text-purple-700 hover:underline">+91 97414 22544</a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-[#73688b]">
      <p>
        &copy; {new Date().getFullYear()} TC Web & Studio. All rights reserved. Mysuru, Karnataka.
      </p>
      <div class="flex items-center gap-4">
        <span>Handcrafted with Modern Web Craft</span>
        <span>•</span>
        <span>100% In-House Founders</span>
      </div>
    </div>

  </div>
</footer>
