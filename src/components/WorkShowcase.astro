---
import Section from './Section.astro';
---

<Section id="work" class="bg-brand-bg">
  <div class="mb-16 md:mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8">
    <div>
      <h2 class="h2 text-brand-text mb-6">Selected Work</h2>
      <p class="max-w-xl">
        A glimpse into our recent collaborations spanning brand identity, digital experiences, and visual storytelling.
      </p>
    </div>
    <a href="#contact" class="inline-flex items-center text-sm font-semibold tracking-widest uppercase text-brand-accent hover:text-brand-text transition-colors group">
      View All Projects 
      <span class="ml-2 group-hover:translate-x-1 transition-transform">&rarr;</span>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
    <!-- Project 1 -->
    <div class="group flex flex-col cursor-pointer">
      <div class="relative w-full aspect-[4/3] bg-[#EAE8E3] overflow-hidden rounded-sm mb-6">
        <!-- Placeholder Abstract Visual -->
        <div class="absolute inset-0 flex items-center justify-center p-12">
           <div class="w-full h-full border border-brand-text/20 rounded-full flex items-center justify-center relative overflow-hidden group-hover:scale-105 transition-transform duration-700 ease-out">
             <div class="absolute inset-0 bg-brand-text/5 rotate-45 transform origin-center translate-y-1/2"></div>
           </div>
        </div>
        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 text-[0.65rem] uppercase tracking-widest font-semibold text-brand-text rounded-full">
          Identity & Web
        </div>
      </div>
      <h3 class="text-xl md:text-2xl font-medium text-brand-text mb-2 group-hover:text-brand-accent transition-colors">Jain Autocars</h3>
      <p class="text-brand-muted text-sm md:text-base">Strategic rebranding and digital presence for a leading automotive dealer.</p>
    </div>

    <!-- Project 2 -->
    <div class="group flex flex-col cursor-pointer md:mt-16">
      <div class="relative w-full aspect-[4/3] bg-brand-text overflow-hidden rounded-sm mb-6">
        <!-- Placeholder Abstract Visual -->
        <div class="absolute inset-0 flex items-center justify-center p-12">
           <div class="w-2/3 h-2/3 border-2 border-white/20 flex items-center justify-center relative overflow-hidden group-hover:scale-105 transition-transform duration-700 ease-out">
             <div class="absolute inset-0 bg-brand-accent/20 rotate-12 transform origin-center"></div>
           </div>
        </div>
        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 text-[0.65rem] uppercase tracking-widest font-semibold text-brand-text rounded-full">
          Brand & Content
        </div>
      </div>
      <h3 class="text-xl md:text-2xl font-medium text-brand-text mb-2 group-hover:text-brand-accent transition-colors">Saaraswath IAS KAS Academy</h3>
      <p class="text-brand-muted text-sm md:text-base">Educational brand positioning and ongoing content strategy.</p>
    </div>

    <!-- Project 3 -->
    <div class="group flex flex-col cursor-pointer">
      <div class="relative w-full aspect-[4/3] bg-[#DFDBD0] overflow-hidden rounded-sm mb-6">
        <!-- Placeholder Abstract Visual -->
        <div class="absolute inset-0 flex items-center justify-center p-12">
           <div class="grid grid-cols-2 grid-rows-2 gap-2 w-2/3 h-2/3 group-hover:scale-105 transition-transform duration-700 ease-out">
             <div class="bg-brand-text/10 rounded-tl-full"></div>
             <div class="bg-brand-text/20 rounded-tr-full"></div>
             <div class="bg-brand-text/30 rounded-bl-full"></div>
             <div class="bg-brand-text/40 rounded-br-full"></div>
           </div>
        </div>
        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 text-[0.65rem] uppercase tracking-widest font-semibold text-brand-text rounded-full">
          Social & Films
        </div>
      </div>
      <h3 class="text-xl md:text-2xl font-medium text-brand-text mb-2 group-hover:text-brand-accent transition-colors">Soulfull Academy</h3>
      <p class="text-brand-muted text-sm md:text-base">Dynamic social media management and promotional filmmaking.</p>
    </div>

    <!-- Project 4 -->
    <div class="group flex flex-col cursor-pointer md:mt-16">
      <div class="relative w-full aspect-[4/3] bg-white border border-brand-border overflow-hidden rounded-sm mb-6">
        <!-- Placeholder Abstract Visual -->
        <div class="absolute inset-0 flex items-center justify-center p-12">
           <div class="w-full h-1/2 border-y border-brand-text/20 flex flex-col justify-center relative overflow-hidden group-hover:scale-105 transition-transform duration-700 ease-out">
             <div class="w-1/2 h-full bg-brand-text/5 absolute left-1/4"></div>
           </div>
        </div>
        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 text-[0.65rem] uppercase tracking-widest font-semibold text-brand-text rounded-full border border-brand-border">
          Digital & Web
        </div>
      </div>
      <h3 class="text-xl md:text-2xl font-medium text-brand-text mb-2 group-hover:text-brand-accent transition-colors">Manikanta Farms</h3>
      <p class="text-brand-muted text-sm md:text-base">Agribusiness digital presence and bespoke website development.</p>
    </div>
  </div>
</Section>
