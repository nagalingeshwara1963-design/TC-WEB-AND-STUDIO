---
// FoundersTrust.astro — Authentic Founders Leadership (Light Corporate Edition)
const founders = [
  {
    name: "Naveen",
    phone: "9742963370",
    displayPhone: "+91 97429 63370",
    role: "Creative Director & Lead Filmmaker",
    skills: ["4K Commercial Videography", "Viral Reel Direction", "Visual Storytelling", "Brand Films"],
    quote: "Every video we film is engineered to command immediate attention within the first 3 seconds and convert viewers into genuine inquiries.",
    badgeBg: "bg-purple-100 text-purple-700 border-purple-200",
    initials: "NV",
    gradient: "from-purple-600 to-indigo-600"
  },
  {
    name: "Hemanth",
    phone: "9741422544",
    displayPhone: "+91 97414 22544",
    role: "Performance Marketing & Growth Lead",
    skills: ["Meta & Google Paid Ads", "ROAS Maximization", "Inbound Lead Funnels", "Multi-Touch Attribution"],
    quote: "We treat your marketing budget like our own. Zero wasted ad spend, laser-focused audience targeting, and weekly transparent ROI reports.",
    badgeBg: "bg-orange-100 text-orange-700 border-orange-200",
    initials: "HM",
    gradient: "from-orange-600 to-amber-600"
  },
  {
    name: "Nidhith",
    phone: "8197974368",
    displayPhone: "+91 81979 74368",
    role: "Lead Web Architect & Content Strategist",
    skills: ["Astro Platform Architecture", "Core Web Vitals 100/100", "Brand Visual Identity", "Regional Copywriting"],
    quote: "We don't build sluggish WordPress websites with 40 plugins. We engineer custom, lightning-fast web platforms that convert visitors into direct clients.",
    badgeBg: "bg-blue-100 text-blue-700 border-blue-200",
    initials: "ND",
    gradient: "from-blue-600 to-cyan-600"
  }
];
---

<section class="py-20 lg:py-28 bg-[#f8fafc] border-b border-slate-200/80" id="studio">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-orange-600 bg-orange-50 border border-orange-200 px-4 py-1.5 rounded-full mb-3 font-display">
        Direct Accountability
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4 font-display leading-tight">
        Work Directly with <span class="text-gradient-orange">Founders</span>, Not Middlemen
      </h2>
      <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-sans">
        Unlike bloated agencies that hand your campaigns off to junior interns, our three founders personally strategize, build, film, and scale your digital presence.
      </p>
    </div>

    <!-- Founders Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {founders.map(founder => (
        <div class="card-luxury p-8 flex flex-col justify-between group relative overflow-hidden bg-white hover:border-slate-300">
          <div class="relative z-10">
            <!-- Header with Initials Badge & Live Indicator -->
            <div class="flex items-start justify-between mb-6">
              <div class="flex items-center gap-3.5">
                <div class="relative">
                  <div class={`w-14 h-14 rounded-2xl bg-gradient-to-br ${founder.gradient} text-white font-extrabold text-lg flex items-center justify-center font-display shadow-md group-hover:scale-105 transition-transform`}>
                    {founder.initials}
                  </div>
                  <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white flex items-center justify-center" title="Active on WhatsApp">
                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                  </span>
                </div>
                <div>
                  <h3 class="text-xl font-bold text-slate-900 font-display">
                    {founder.name}
                  </h3>
                  <a href={`tel:+91${founder.phone}`} class="text-xs font-mono font-bold text-slate-500 hover:text-blue-600 block mt-0.5 transition-colors">
                    {founder.displayPhone}
                  </a>
                </div>
              </div>
              <span class={`text-[9px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-full border ${founder.badgeBg}`}>
                Founder
              </span>
            </div>

            <!-- Role Badge -->
            <div class="mb-5">
              <span class="text-xs font-bold text-slate-800 font-display block">
                {founder.role}
              </span>
            </div>

            <!-- Quote -->
            <blockquote class="text-slate-600 text-sm leading-relaxed mb-6 italic font-sans border-l-2 border-orange-400 pl-4 bg-slate-50/70 py-2 rounded-r-xl">
              "{founder.quote}"
            </blockquote>

            <!-- Skill Tags -->
            <div class="pt-4 border-t border-slate-100">
              <span class="block text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 mb-2.5">Key Focus Areas:</span>
              <div class="flex flex-wrap gap-1.5">
                {founder.skills.map(skill => (
                  <span class="text-[11px] font-mono bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md font-medium border border-slate-200/60">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Direct Contact Action Bar -->
          <div class="mt-8 pt-5 border-t border-slate-200 flex items-center gap-2 relative z-10">
            <a 
              href={`https://wa.me/91${founder.phone}?text=Hi%20${founder.name}%2C%20I%20would%20like%20to%20discuss%20a%20project%20with%20TC%20Web%20%26%20Studio.`}
              target="_blank" 
              rel="noopener noreferrer"
              class="flex-1 py-3 px-3 rounded-xl bg-emerald-50 hover:bg-emerald-600 text-emerald-800 hover:text-white border border-emerald-200 text-xs font-bold flex items-center justify-center gap-2 transition-all shadow-sm group-hover:border-emerald-300"
              aria-label={`WhatsApp ${founder.name} directly`}
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
              <span>WhatsApp {founder.name}</span>
            </a>
            
            <a 
              href={`tel:+91${founder.phone}`}
              class="p-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 hover:text-slate-900 border border-slate-200 transition-all flex items-center justify-center shadow-sm"
              aria-label={`Call ${founder.name} at ${founder.displayPhone}`}
              title={`Call ${founder.displayPhone}`}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust Guarantees -->
    <div class="mt-14 grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
      <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-sm">
        <span class="block text-xl font-extrabold text-slate-900 font-display">100% In-House</span>
        <span class="text-xs text-slate-500">Zero sub-contracting or hidden agency fees</span>
      </div>
      <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-sm">
        <span class="block text-xl font-extrabold text-slate-900 font-display">24-Hour Responses</span>
        <span class="text-xs text-slate-500">Direct founder WhatsApp group on all campaigns</span>
      </div>
      <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-sm">
        <span class="block text-xl font-extrabold text-slate-900 font-display">Transparent Reporting</span>
        <span class="text-xs text-slate-500">Live rankings, call tracking & metric audits</span>
      </div>
    </div>

  </div>
</section>
