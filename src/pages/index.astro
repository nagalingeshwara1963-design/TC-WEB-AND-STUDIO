---
// index.astro — TC Web & Studio (Light Purple Tint & Gold Luxury Theme)
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroAgency from '../components/HeroAgency.astro';
import AboutCompany from '../components/AboutCompany.astro';
import TeamPortfolio from '../components/TeamPortfolio.astro';
import ClientsSection from '../components/ClientsSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import PricingSection from '../components/PricingSection.astro';
import ContactSection from '../components/ContactSection.astro';
import FooterClean from '../components/FooterClean.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
---

<Layout 
	title="TC Web & Studio | Digital Marketing, Custom Web & Visual Creative Studio in Mysuru"
	description="Premier Digital Marketing, Custom Web Development, 4K Commercial Video Reels & High-Impact Poster Design in Mysuru, Karnataka. Three founders, 100% in-house craft, customized to your budget."
>
	<!-- Modern Frosted Glass Navigation with Purple Tint & Gold Accents -->
	<Navbar />

	<main id="main-content" class="flex-grow">
		<!-- Opening First Face: Intro + Creative Services (Left) & Get Quote Card + Muted Intro Video (Right) -->
		<HeroAgency />

		<!-- About Us (The Company): 3-Founder Story & Skill-First Philosophy -->
		<AboutCompany />

		<!-- Team Portfolio: Naveen (Loop Videos), Nidhith (Posters), Hemanth (Web Designs) -->
		<TeamPortfolio />

		<!-- Clients Section: Previous & Current Clients (Authentic, No Fake Metrics) -->
		<ClientsSection />

		<!-- Services Section: Complete Breakdown of Every Creative & Digital Service -->
		<ServicesSection />

		<!-- Our Prices: Customized to Budget, Small Team Advantage, Separate Meta Ad Spend & SEO -->
		<PricingSection />

		<!-- Contact Section: All 3 Founders' Direct Numbers, WhatsApp routes to Nidhith -->
		<ContactSection />
	</main>

	<!-- Clean Studio Footer -->
	<FooterClean />

	<!-- Persistent Floating WhatsApp Action directly to Nidhith -->
	<FloatingWhatsApp />
</Layout>
